---
// Home, "Partners": a black band, like the "Conservation partners" band on Colossal's Home page.
// The title in the thin wide readout type, then right under it, flush left, the partners' logos in a
// row that grows as more sign on (white logos, no frames). Under the logos, "Build it with us." with
// the buttons.
// Everything is in src/data/home.ts (`partners`); logos are in public/images/partners/.
import { partners } from '../data/home';
import { url } from '../lib/url';

interface Props {
  number: number;
}

const { number } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="band partners-band">
  <span class="plus" style="top: 3rem; left: 2%"></span>
  <span class="plus" style="top: 46%; right: 1.5%"></span>
  <span class="plus" style="bottom: 4rem; left: 38%"></span>
  <section class="container section partners" aria-labelledby="partners-title">
    <header class="partners-head" data-reveal>
      <p class="label partners-num">Section {pad(number)}</p>
      <h2 class="readout partners-title" id="partners-title">{partners.title}</h2>
    </header>

    <!-- The logos, flush left, in the order the partners joined -->
    <ul class="wall" data-reveal-group>
      {partners.members.map((member) => (
        <li>
          {member.href ? (
            <a class="logo" href={member.href} target="_blank" rel="noopener noreferrer">
              <img src={url(`/images/partners/${member.logo}`)} alt={member.name} loading="lazy" decoding="async" />
            </a>
          ) : (
            <span class="logo">
              <img src={url(`/images/partners/${member.logo}`)} alt={member.name} loading="lazy" decoding="async" />
            </span>
          )}
        </li>
      ))}
    </ul>

    <!-- Under the logos: the invitation and the buttons -->
    <div class="partners-invite" data-reveal>
      <p class="readout partners-lead">{partners.lead}</p>
      <div>
        <p class="partners-text">{partners.text}</p>
        <div class="partners-actions">
          <a class="button" href={url(partners.cta.href)}>{partners.cta.label} <span aria-hidden="true">→</span></a>
          <a class="text-link label" href={url(partners.secondary.href)}>{partners.secondary.label} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  /* pure black, so the white logos sit on it like a sponsor wall */
  .partners-band {
    --color-bg: #000000;
    --color-surface: #0c0f12;
    --color-line: #262b30;
    color: var(--color-text);
    background: var(--color-bg);
  }

  .section {
    padding-top: var(--space-2xl);
  }

  /* ---------- The title ---------- */

  .partners-head {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
  }

  .partners-num {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
  }

  .partners-title {
    margin: 0;
    font-size: var(--display-2);
  }

  /* ---------- The logos: a row from the left that wraps as it grows ---------- */

  .wall {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg) clamp(2.5rem, 5vw, 5rem);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .logo {
    display: block;
    transition: opacity var(--duration) var(--ease);
  }

  .logo img {
    display: block;
    width: auto;
    height: clamp(4.5rem, 3rem + 3vw, 6.5rem);
  }

  a.logo:hover {
    opacity: 0.75;
  }

  /* ---------- Under the logos: Build it with us ---------- */

  .partners-invite {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-md) clamp(2rem, 5vw, 6rem);
    align-items: start;
    margin-top: var(--space-2xl);
  }

  .partners-lead {
    margin: 0;
    font-size: var(--display-3);
    text-wrap: balance;
  }

  .partners-text {
    max-width: 36rem;
    margin: 0 0 var(--space-lg);
    color: var(--color-muted);
  }

  .partners-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
  }

  /* ---------- Smaller screens ---------- */

  @media (max-width: 900px) {
    .partners-invite {
      grid-template-columns: 1fr;
      margin-top: var(--space-xl);
    }
  }

  @media (max-width: 600px) {
    .logo img {
      height: auto;
      max-width: min(17rem, 100%);
    }

    /* the "+" margin marks would land on the text on a narrow screen */
    .partners-band > .plus {
      display: none;
    }
  }
</style>
