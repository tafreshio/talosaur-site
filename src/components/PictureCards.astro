---
// A row of picture cards, each one a photo that goes with what its card says (like the photo-led
// sections on Colossal's species pages). Every second card sits lower, so the row isn't flat.
//
//   <PictureCards columns={4} items={[{ image: 'aud-research.jpg', tag: 'Research', title: 'Research', text: '...' }]} />
//
// Photos live in public/images/sections/. People, lab and machine photos stay natural; nature
// photos may have false colour (see the photo rule in the README).
import { imageUrl } from '../lib/images';

interface Item {
  image: string;     // file name in public/images/sections/
  title: string;     // short heading under the photo
  text: string;      // a line or two (a [bracket] placeholder until it's written)
  tag?: string;      // small label on the photo's corner
}

interface Props {
  items: Item[];
  columns?: 3 | 4;
  ratio?: string;    // photo shape, width / height
}

const { items, columns = 3, ratio = columns === 4 ? '4 / 5' : '4 / 3' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class:list={['pcards', `pcards--${columns}`]} data-reveal-group>
  {items.map((item, i) => (
    <li class="pcard">
      <div class="pcard-media">
        <img src={imageUrl(`sections/${item.image}`)} alt="" loading="lazy" decoding="async" style={`aspect-ratio: ${ratio};`} />
        {item.tag && <span class="label pcard-tag" aria-hidden="true">[ {item.tag} ]</span>}
      </div>
      <p class="label pcard-num">{pad(i + 1)}</p>
      <h3 class="pcard-title">{item.title}</h3>
      <p class="pcard-text">{item.text}</p>
    </li>
  ))}
</ol>

<style>
  .pcards {
    --step: clamp(2rem, 5vw, 5rem);  /* how much lower every second card sits */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-xl) var(--space-md);
    margin: 0;
    padding: 0 0 var(--step);
    list-style: none;
  }

  .pcards--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  /* "translate" (not "transform"), so it adds to the fade-in animation instead of being replaced by it */
  .pcard:nth-child(2n) {
    translate: 0 var(--step);
  }

  .pcard-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .pcard-media img {
    width: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .pcard:hover .pcard-media img {
    transform: scale(1.03);
  }

  .pcard-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-white);
    background: rgb(6 18 31 / 0.6);
  }

  .pcard-num {
    margin: var(--space-sm) 0 0;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-accent);
    color: var(--color-accent);
  }

  .pcard-title {
    margin-top: var(--space-xs);
    font-size: var(--text-xl);
  }

  .pcard-text {
    margin: var(--space-xs) 0 0;
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* Tablet: two across */
  @media (max-width: 1023px) {
    .pcards,
    .pcards--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Phone: the four-card version stays two across (smaller); the three-card version stacks */
  @media (max-width: 600px) {
    .pcards {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding-bottom: 0;
    }

    .pcards .pcard:nth-child(2n) {
      translate: none;
    }

    .pcards--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-lg) var(--space-sm);
      padding-bottom: var(--step);
    }

    .pcards--4 .pcard:nth-child(2n) {
      translate: 0 var(--step);
    }

    .pcard-title {
      font-size: 1.25rem;
    }

    .pcard-text {
      font-size: var(--text-sm);
    }
  }
</style>
