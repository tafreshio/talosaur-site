---
// Shared footer. Used on every page through BaseLayout.astro.
import { footerColumns, socialLinks, footerLegal, contactEmails } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-columns">
      <!-- The logo, at about the size it has in the top bar: the white lockup from the brand pack -->
      <div class="footer-brand">
        <a href={url('/')} class="footer-logo" aria-label="Talosaur home">
          <img src={url('/brand/talosaur-lockup-white.svg')} alt="Talosaur" width="4983" height="852" loading="lazy" decoding="async" />
        </a>
      </div>

      {footerColumns.map((column) => (
        <div class="footer-column">
          <h2 class="label">{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li><a href={url(link.href)}>{link.label}</a></li>
            ))}
            {column.title === 'Can we help?' && contactEmails.map((contact) => (
              <li class="footer-email">
                <!-- <wbr> lets a long address break after the @ on a narrow phone, never mid-word -->
                <a href={`mailto:${contact.email}`} title={contact.label}>{contact.email.split('@')[0]}@<wbr />{contact.email.split('@')[1]}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="footer-column">
        <h2 class="label">Connect with us</h2>
        <ul>
          {socialLinks.map((link) => (
            <li>
              {link.href
                ? <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span class="ext" aria-hidden="true">↗</span></a>
                : <span class="footer-pending">{link.label} <span class="label footer-soon">[ soon ]</span></span>}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} Talosaur</span>
      <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      {footerLegal.map((link) => (
        <a href={url(link.href)}>{link.label}</a>
      ))}
      <span>A Texas-based student team</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative; /* paints over anything drifting down from the last section */
    margin-top: 0; /* the section above already ends with its own space */
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  /* the logo on the left, then the three columns of links */
  .footer-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .footer-logo {
    display: inline-block;
    transition: opacity var(--duration) var(--ease);
  }

  .footer-logo img {
    display: block;
    width: auto;
    height: 2rem;
  }

  .footer-logo:hover {
    opacity: 0.8;
  }

  .footer-column h2 {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono); /* override the big uppercase heading style */
    font-stretch: normal;
    line-height: 1.4;
  }

  .footer-column ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column li {
    padding: 0.35rem 0;
    font-size: var(--text-lg);
  }

  .footer-column a {
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .footer-column a:hover {
    color: var(--color-accent);
  }

  /* a channel with no link yet: the same name style as the others, with a small "[ soon ]" after it,
     the two kept together on one line */
  .footer-pending {
    white-space: nowrap;
  }

  .footer-soon {
    margin-left: 0.35rem;
    white-space: nowrap;
    font-size: 0.62rem;
    color: var(--color-muted);
    vertical-align: 0.2em;
  }

  /* the three email addresses under "Can we help?", smaller, in the label font */
  .footer-email {
    font-family: var(--font-mono);
  }

  .footer-column .footer-email {
    font-size: var(--text-sm);
  }

  /* padded so each address is a comfortable tap target on a phone */
  .footer-email a {
    display: inline-block;
    padding-block: 0.35rem;
    color: rgb(232 241 245 / 0.78);
  }

  .footer-column li.footer-email {
    padding-block: 0;
  }

  .footer-email:first-of-type {
    margin-top: var(--space-xs);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-md);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* padded so each link is a comfortable tap target on a phone (about 30 px tall) */
  .footer-bottom a {
    display: inline-block;
    padding-block: 0.5rem;
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--color-accent);
  }

  .ext {
    font-size: 0.8em;
  }

  .back-to-top {
    order: 1; /* sits just before the right-aligned tagline */
  }

  /* Push the tagline to the right on wide screens */
  .footer-bottom span:last-child {
    order: 2;
    margin-left: auto;
  }

  /* tablets: the logo gets a row of its own above the three columns */
  @media (max-width: 900px) {
    .footer-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .footer-columns {
      grid-template-columns: 1fr 1fr;
    }

    .footer-column .footer-email {
      font-size: 0.8125rem;
    }

    .footer-bottom span:last-child {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
