---
// Shared footer. Used on every page through BaseLayout.astro.
import { footerColumns, socialLinks, footerLegal, teamEmail, isPlaceholder } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-columns">
      {footerColumns.map((column) => (
        <div class="footer-column">
          <h2 class="label">{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
            {column.title === 'Can we help?' && (
              <li>
                {isPlaceholder(teamEmail)
                  ? <span class="placeholder">{teamEmail}</span>
                  : <a href={`mailto:${teamEmail}`}>{teamEmail}</a>}
              </li>
            )}
          </ul>
        </div>
      ))}

      <div class="footer-column">
        <h2 class="label">Connect with us</h2>
        <ul>
          {socialLinks.map((link) => (
            <li>
              {link.href
                ? <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span class="ext" aria-hidden="true">↗</span></a>
                : <span title="Link coming soon">{link.label}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Oversized wordmark. PLACEHOLDER: swap for the logo file when we have one -->
    <p class="footer-wordmark" aria-hidden="true">Talosaur</p>

    <div class="footer-bottom">
      <span>&copy; {year} Talosaur</span>
      <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      {footerLegal.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <span>A Texas-based student team</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .footer-column h2 {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono); /* override the big uppercase heading style */
    font-stretch: normal;
    line-height: 1.4;
  }

  .footer-column ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column li {
    padding: 0.35rem 0;
    font-size: var(--text-lg);
  }

  .footer-column a {
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .footer-column a:hover {
    color: var(--color-accent);
  }

  .footer-column span {
    color: var(--color-muted);
  }

  .placeholder {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .footer-wordmark {
    margin: var(--space-xl) 0 0;
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 900;
    font-size: clamp(4rem, 19vw, 19rem); /* fills the width on any screen */
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-surface);
    user-select: none;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .footer-bottom a {
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--color-accent);
  }

  .ext {
    font-size: 0.8em;
  }

  .back-to-top {
    order: 1; /* sits just before the right-aligned tagline */
  }

  /* Push the tagline to the right on wide screens */
  .footer-bottom span:last-child {
    order: 2;
    margin-left: auto;
  }

  @media (max-width: 700px) {
    .footer-columns {
      grid-template-columns: 1fr 1fr;
    }

    .footer-bottom span:last-child {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
