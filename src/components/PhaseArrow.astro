---
// News, "Where we are": our overall phase as one arrow. Four phases from the bench to the twilight
// zone; the line is solid up to the orange "now" dot in the current phase and dotted after it, and
// the arrow points at the goal (a photo of deep-sea life). No scrolling: it always fits the width.
// On phones the arrow runs down the left instead.
//
// The phases and which one we're in are set where the component is used (src/pages/news.astro):
//   <PhaseArrow current={1} phases={[{ title: 'Build', text: '...' }, ...]} goal={{ image, tag, caption }} />
import { imageExists, imageUrl } from '../lib/images';

interface Props {
  current: number; // 1 = the first phase
  phases: { title: string; text: string }[];
  goal?: { image: string; tag: string; caption: string };
}

const { current, phases, goal } = Astro.props;
const hasGoal = !!goal && imageExists(goal.image);
const pad = (n: number) => String(n).padStart(2, '0');
const stateOf = (i: number) => (i + 1 < current ? 'done' : i + 1 === current ? 'now' : 'next');
---

<div class:list={['phase', { 'phase--goal': hasGoal }]}>
  <div class="phase-track" style={`--count: ${phases.length}; --current: ${current}`}>
  <span class="phase-fill" aria-hidden="true"></span>
  <ol class="phase-steps">
    {phases.map((phase, i) => (
      <li class:list={['phase-step', `phase-step--${stateOf(i)}`]}>
        {stateOf(i) === 'now' && <span class="phase-now" aria-hidden="true"><span class="phase-dot"></span><span class="label">Now</span></span>}
        <span class="label phase-num">Phase {pad(i + 1)}</span>
        <h3 class="phase-title">{phase.title}</h3>
        <p class="phase-text">{phase.text}</p>
        {stateOf(i) === 'now' && <span class="visually-hidden">(the phase we are in now)</span>}
      </li>
    ))}
  </ol>
  </div>

  {hasGoal && goal && (
    <figure class="phase-goal">
      <div class="phase-goal-frame">
        <img src={imageUrl(goal.image)} alt="" width="1400" height="979" loading="lazy" decoding="async" />
        <span class="phase-corner phase-corner--tl"></span>
        <span class="phase-corner phase-corner--br"></span>
      </div>
      <figcaption class="phase-goal-caption"><span class="tag">{goal.tag}</span> {goal.caption}</figcaption>
    </figure>
  )}
</div>

<style>
  .phase {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    margin-bottom: var(--space-xl);
  }

  .phase--goal {
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 17rem);
  }

  /* ---------- The arrow ---------- */

  .phase-track {
    --line-y: 0.6rem;
    position: relative;
  }

  .phase-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    margin: 0;
    padding: 0 1.5rem 0 0; /* room for the arrowhead */
    list-style: none;
  }

  /* the shaft: dotted all the way to the arrowhead */
  .phase-steps::before {
    content: '';
    position: absolute;
    top: var(--line-y);
    left: 0;
    right: 0.2rem;
    height: 1px;
    background: repeating-linear-gradient(to right, var(--color-muted) 0 4px, transparent 4px 8px);
  }

  /* the arrowhead */
  .phase-steps::after {
    content: '';
    position: absolute;
    top: calc(var(--line-y) - 0.4rem);
    right: 0.15rem;
    width: 0.8rem;
    height: 0.8rem;
    border-top: 1.5px solid var(--color-text);
    border-right: 1.5px solid var(--color-text);
    transform: translateY(0.02rem) rotate(45deg);
  }

  /* solid from the start to the middle of the current phase (where the "now" dot is) */
  .phase-fill {
    position: absolute;
    z-index: 1;
    top: calc(var(--line-y) - 1px);
    left: 0;
    width: calc((100% - 1.5rem) * (var(--current) - 0.5) / var(--count));
    height: 3px;
    background: var(--color-orange);
  }

  .phase-step {
    position: relative;
    padding: 2.2rem var(--space-md) 0 0;
  }

  /* a tick where each phase starts */
  .phase-step::before {
    content: '';
    position: absolute;
    top: calc(var(--line-y) - 0.45rem);
    left: 0;
    width: 1px;
    height: 0.9rem;
    background: var(--color-text);
  }

  .phase-now {
    position: absolute;
    z-index: 2;
    top: calc(var(--line-y) - 0.45rem);
    left: calc(50% - 0.45rem);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .phase-dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 0 4px rgb(255 122 47 / 0.22);
  }

  .phase-now .label {
    margin-top: -1.9rem;
    margin-left: -1.6rem;
    color: var(--color-orange);
  }

  .phase-num {
    display: block;
    margin: 0 0 0.35rem;
  }

  .phase-step--now .phase-num {
    color: var(--color-orange);
  }

  .phase-title {
    margin-bottom: 0.4rem;
    font-size: var(--display-4);
  }

  .phase-text {
    max-width: 18rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .phase-step--next .phase-title {
    color: var(--color-muted);
  }

  /* ---------- The goal at the arrow's end ---------- */

  .phase-goal {
    margin: 0;
  }

  .phase-goal-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: #000;
  }

  .phase-goal-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phase-corner {
    position: absolute;
    width: 0.8rem;
    height: 0.8rem;
    border: 0 solid rgb(255 255 255 / 0.75);
  }

  .phase-corner--tl { top: 0.5rem; left: 0.5rem; border-top-width: 1px; border-left-width: 1px; }
  .phase-corner--br { right: 0.5rem; bottom: 0.5rem; border-right-width: 1px; border-bottom-width: 1px; }

  .phase-goal-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin-top: 0.6rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* ---------- Tablets: the goal goes under the arrow ---------- */

  @media (max-width: 1023px) {
    .phase--goal {
      grid-template-columns: minmax(0, 1fr);
    }

    .phase-goal {
      max-width: 22rem;
    }
  }

  /* ---------- Phones: the arrow runs down the left ---------- */

  @media (max-width: 640px) {
    .phase-steps {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      padding: 0 0 1.6rem 2.2rem;
    }

    .phase-steps::before {
      top: 0;
      bottom: 0.25rem;
      left: 0.6rem;
      right: auto;
      width: 1px;
      height: auto;
      background: repeating-linear-gradient(to bottom, var(--color-muted) 0 4px, transparent 4px 8px);
    }

    .phase-steps::after {
      top: auto;
      bottom: 0.2rem;
      right: auto;
      left: calc(0.6rem - 0.4rem);
      transform: rotate(135deg);
    }

    .phase-fill {
      top: 0;
      left: calc(0.6rem - 1px);
      width: 3px;
      /* down to the "now" dot: the phases before it, plus half a row */
      height: calc((100% - 1.6rem) * (var(--current) - 0.5) / var(--count));
    }

    .phase-step {
      padding: 0;
    }

    .phase-step::before {
      top: 0.45rem;
      left: calc(-2.2rem + 0.6rem - 0.45rem);
      width: 0.9rem;
      height: 1px;
    }

    .phase-now {
      top: 0.05rem;
      left: calc(-2.2rem + 0.6rem - 0.45rem);
    }

    .phase-now .label {
      display: none;
    }

    .phase-title {
      font-size: var(--display-5);
    }

    .phase-goal {
      max-width: 15rem;
    }
  }
</style>
