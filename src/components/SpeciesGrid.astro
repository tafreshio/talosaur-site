---
// A hundred sea animals standing for every species in the ocean: how many have a scientific name.
//   orange   9: named, by any count (one study says 91% are still undescribed)
//   cyan     24 more: named, by NOAA's count (about two-thirds still undescribed)
//   outline  the other 67: still waiting for a name
// The animals are simple shapes (fish, jellyfish, squid, sea star) in a fixed mixed order.
// A still picture, no motion. Numbers and sources: explored.named in src/data/problem.ts.
const COLS = 10;
const SHAPES = ['fish', 'jelly', 'squid', 'star'];
// a fixed mixed order, so the rows don't repeat in an obvious pattern
const order = Array.from({ length: 100 }, (_, i) => SHAPES[(i * 7 + Math.floor(i / 3)) % SHAPES.length]);
const stateOf = (i: number) => (i < 9 ? 'any' : i < 33 ? 'noaa' : 'unnamed');
---

<div class="species-grid">
  <svg viewBox="0 0 300 300" role="img" aria-label="A grid of 100 sea animals: 9 named by any count, 24 more named by NOAA's count, and 67 still unnamed">
    <defs>
      <symbol id="sp-fish" viewBox="0 0 24 24"><path d="M2.5 12c3.2-4.6 8.4-5.6 12.4-3.1L21.5 5v14l-6.6-3.9C10.9 17.6 5.7 16.6 2.5 12z" /></symbol>
      <symbol id="sp-jelly" viewBox="0 0 24 24"><path d="M4.5 12.5a7.5 7.5 0 0 1 15 0z" /><path class="sp-strand" d="M7 13v6M10.3 13v8M13.7 13v8M17 13v6" /></symbol>
      <symbol id="sp-squid" viewBox="0 0 24 24"><path d="M12 2l4.2 5.8v7.4L14 17.4V22l-2-2.8-2 2.8v-4.6l-2.2-2.2V7.8z" /></symbol>
      <symbol id="sp-star" viewBox="0 0 24 24"><path d="M12 2.5l2.6 6.2 6.7.6-5.1 4.4 1.6 6.6L12 16.8l-5.8 3.5 1.6-6.6-5.1-4.4 6.7-.6z" /></symbol>
    </defs>
    {order.map((shape, i) => (
      <use href={`#sp-${shape}`} x={(i % COLS) * 30 + 3} y={Math.floor(i / COLS) * 30 + 3} width="24" height="24" class={`sp sp--${stateOf(i)}`} />
    ))}
  </svg>
  <ul class="species-key">
    <li class="label"><span class="key key--any"></span>9 named, by any count</li>
    <li class="label"><span class="key key--noaa"></span>24 more, by NOAA's count</li>
    <li class="label"><span class="key key--unnamed"></span>Still unnamed</li>
  </ul>
</div>

<style>
  .species-grid svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .sp {
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .sp--any {
    color: var(--color-orange);
    fill: currentColor;
    stroke: currentColor;
  }

  .sp--noaa {
    color: var(--color-accent);
    fill: currentColor;
    stroke: currentColor;
  }

  .sp--unnamed {
    color: color-mix(in srgb, var(--color-text) 45%, transparent);
    fill: none;
    stroke: currentColor;
  }

  .species-key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .species-key li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text);
  }

  .key {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
  }

  .key--any {
    background: var(--color-orange);
  }

  .key--noaa {
    background: var(--color-accent);
  }

  .key--unnamed {
    border: 1px solid color-mix(in srgb, var(--color-text) 45%, transparent);
  }
</style>
