---
// Full-screen video hero at the top of the Home page: just the video and the Talosaur logo.
// The headline and intro text come right after it, in Section 01 (src/pages/index.astro).
//
// The same video comes in two sizes, and each visitor's browser downloads only one:
//   public/videos/hero-1080.mp4    1920 x 1080, for screens 900 px wide or more
//   public/videos/hero.mp4         1280 x 720, for phones, small windows and anything else
//   public/images/hero-poster.jpg  a still from the video, shown while it loads
//                                  and to visitors who have "reduce motion" turned on
//
// The browser goes down the list below and plays the first file whose "media" rule fits
// its screen. To swap the video, replace the files and keep the same names. A missing
// file is simply left out of the list. If both are missing, only the poster shows,
// with a placeholder tag.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { url } from '../lib/url';

const videoFiles = [
  { file: 'videos/hero-1080.mp4', type: 'video/mp4', media: '(min-width: 900px)' },
  { file: 'videos/hero.mp4', type: 'video/mp4' }, // no media rule, so it is the fallback for everyone else
];
const posterFile = 'images/hero-poster.jpg';

// Checked when the site is built, so adding or removing a file is all it takes.
const sources = videoFiles
  .filter(({ file }) => existsSync(join(process.cwd(), 'public', file)))
  .map(({ file, ...rest }) => ({ src: url(`/${file}`), ...rest })); // url() adds the site's base folder, if it has one
const hasVideo = sources.length > 0;
const posterSrc = url(`/${posterFile}`);
---

<section class="hero">
  <div class="hero-media" aria-hidden="true" data-parallax="0.4">
    <!-- The still image. Always here, underneath the video. -->
    <img class="hero-poster" src={posterSrc} alt="" fetchpriority="high" />

    {hasVideo && (
      <video
        class="hero-video"
        poster={posterSrc}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      >
        {sources.map((s) => <source src={s.src} type={s.type} media={s.media} />)}
      </video>
    )}
  </div>

  {!hasVideo && (
    <p class="hero-placeholder-tag label">
      Placeholder: hero video (public/videos/hero-1080.mp4 and hero.mp4) and still image (public/images/hero-poster.jpg)
    </p>
  )}

  <div class="container hero-content">
    <!-- Logo: replace public/brand/talosaur-lockup-white.svg to change it (keep it pure white) -->
    <img class="hero-wordmark" src={url('/brand/talosaur-lockup-white.svg')} alt="Talosaur" width="4983" height="852" />

    <a class="hero-scroll label" href="#intro">
      Scroll <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<script>
  // Reduced motion: remove the video entirely so it never plays (or downloads).
  // The poster image underneath stays visible.
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (video && reduceMotion.matches) {
    video.pause();
    video.querySelectorAll('source').forEach((source) => source.remove());
    video.load();
    video.remove();
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* Fill the screen. The header floats on top, so pull the hero up underneath it. */
    min-height: 100vh;
    min-height: 100svh; /* "small viewport height": ignores phone browser toolbars */
    margin-top: calc(-1 * var(--header-height));
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Poster and video both cover the whole hero, cropping the edges if needed */
  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dark fade at the top so the menu stays readable. There is no fade at the bottom:
     the wordmark inverts the video instead (see .hero-wordmark below), and a dark fade
     there would leave it nothing to invert. */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 50%, transparent) 0%, transparent 20%);
  }

  /* Belt and braces: if the script hasn't run yet, still hide the video */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }

  .hero-placeholder-tag {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--header-height) + var(--space-sm));
    max-width: calc(100% - 2 * var(--gutter));
    margin: 0;
    padding: 0.4rem 0.7rem;
    border: 1px dashed var(--color-muted);
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
  }

  .hero-content {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: clamp(2rem, 6svh, 4rem);
  }

  /* Giant logo in the lower part of the video: the white lockup from the brand pack.
     mix-blend-mode: difference subtracts the video's colors from the white logo, so the
     stripes and letters show the video inverted: copper over blue water, black over a
     white flash. It stays readable over any shot without a dark fade, and changes with
     every cut. It needs a pure white logo to be a true invert, and only works because
     .hero has "isolation: isolate", which keeps the blend inside the hero. */
  .hero-wordmark {
    display: block;
    flex: 1 1 auto;
    width: 100%;
    max-width: calc(100% - 7rem); /* leaves room for "Scroll" on wide screens */
    height: auto;
    mix-blend-mode: difference;
    animation: rise 1.2s var(--ease) both;
  }

  @media (max-width: 760px) {
    .hero-wordmark {
      max-width: 100%; /* phones: full width, "Scroll" wraps underneath */
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.3em);
    }
  }

  /* Same invert as the wordmark, so it doesn't disappear on bright shots */
  .hero-scroll {
    padding-bottom: 0.35em;
    color: var(--color-white);
    mix-blend-mode: difference;
    text-decoration: none;
    animation: rise 1.2s 400ms var(--ease) both;
  }

  .hero-scroll:hover {
    color: var(--color-accent);
    mix-blend-mode: normal; /* show the real accent color on hover, not its inverse */
  }

  .hero-scroll span {
    display: inline-block;
    animation: bob 2s var(--ease) infinite;
  }

  @keyframes bob {
    50% { transform: translateY(4px); }
  }
</style>
