---
// Numbered steps on a stepped line, like the dive profile of the Home roadmap: each step sits a
// little deeper than the one before, joined by a line that runs along and then drops to the next
// ring. Orange rings (orange = markers), readout-voice numbers, headline-voice titles.
// On phones it becomes a plain list with the line down the left.
//
//   <Steps steps={[{ title: 'Apply', text: '...' }, ...]} />
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="steps" style={`--count: ${steps.length}`} data-reveal-group>
  {steps.map((step, i) => (
    <li class="step" style={`--i: ${i}`}>
      <span class="step-ring" aria-hidden="true"></span>
      <span class="readout step-num" aria-hidden="true">{pad(i + 1)}</span>
      <h3 class="step-title">{step.title}</h3>
      <p class="step-text">{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    --drop: 2.4rem; /* how much deeper each step sits */
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    gap: 0 var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    margin-top: calc(var(--i) * var(--drop));
    padding-top: 2.4rem;
  }

  /* the line: along from this ring to the end of the column, then down to the next ring's level */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 0.7rem;
    left: 1.4rem;
    right: calc(var(--space-md) * -1 + 0.35rem);
    height: 1px;
    background: var(--color-text);
    opacity: 0.55;
  }

  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 0.7rem;
    right: calc(var(--space-md) * -1 + 0.35rem);
    width: 1px;
    height: var(--drop);
    background: var(--color-text);
    opacity: 0.55;
  }

  .step-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.4rem;
    height: 1.4rem;
    border: 1.5px solid var(--color-orange);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .step-ring::after {
    content: '';
    position: absolute;
    inset: 0.3rem;
    border-radius: 50%;
    background: var(--color-orange);
  }

  .step-num {
    display: block;
    margin-bottom: var(--space-sm);
    font-size: var(--readout-2);
    line-height: 0.9;
    color: var(--color-text);
  }

  .step-title {
    margin-bottom: 0.45rem;
    font-size: var(--display-5);
  }

  .step-text {
    margin: 0;
    max-width: 24rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding: 0 0 0 2.4rem;
    }

    .step {
      margin-top: 0;
      padding-top: 0;
    }

    .step-ring {
      left: -2.4rem;
      top: 0.4rem;
    }

    .step:not(:last-child)::before {
      top: 1.8rem;
      left: calc(-2.4rem + 0.7rem - 0.5px);
      right: auto;
      bottom: calc(var(--space-lg) * -1 - 0.4rem);
      width: 1px;
      height: auto;
    }

    .step:not(:last-child)::after {
      display: none;
    }
  }
</style>
