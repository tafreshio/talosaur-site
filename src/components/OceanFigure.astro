---
// One figure with a small drawing of what it means, Colossal-style ("50%" inside a thin ring).
//   ring   a ring filled to `percent`, labelled "Mapped" in the middle (how much of the seafloor is mapped)
//   dot    a square standing for the whole deep seafloor, with the part anyone has seen drawn to scale:
//          a single dot, circled so you can find it
//   range  a bar of the share still unnamed: solid up to `low`%, hatched on to `high`% (two estimates)
// size="sm" is the compact version for the Home intro.
//
// The figures and their sources are `explored` in src/data/problem.ts.
interface Source {
  label: string;
  href: string;
}

interface Props {
  kind: 'ring' | 'dot' | 'range';
  value: string;
  caption: string;
  percent?: number;   // ring
  low?: number;       // range
  high?: number;      // range
  sources?: Source[];
  size?: 'lg' | 'sm';
}

const { kind, value, caption, percent = 0, low = 0, high = 0, sources = [], size = 'lg' } = Astro.props;

// Ring: a circle of radius 44 in a 100 x 100 box; the arc is that share of its length, starting at the top
const R = 44;
const C = 2 * Math.PI * R;
const arc = (C * percent) / 100;
---

<figure class:list={['ofig', `ofig--${kind}`, `ofig--${size}`]}>
  <div class="ofig-art" aria-hidden="true">
    {kind === 'ring' && (
      <div class="ofig-ring">
        <svg viewBox="0 0 100 100">
          <circle class="ring-track" cx="50" cy="50" r={R} />
          <circle class="ring-arc" cx="50" cy="50" r={R} stroke-dasharray={`${arc.toFixed(2)} ${C.toFixed(2)}`} transform="rotate(-90 50 50)" />
        </svg>
        <span class="label ofig-ring-label">Mapped</span>
      </div>
    )}

    {kind === 'dot' && (
      <div class="ofig-square">
        <!-- 0.001% of the square's area is a square about 1/300 of its side: one dot -->
        <span class="ofig-seen"></span>
        <span class="ofig-seen-ring"></span>
        <span class="label ofig-seen-label">Seen so far, to scale</span>
        <span class="label ofig-square-label">The deep seafloor</span>
      </div>
    )}

    {kind === 'range' && (
      <div class="ofig-range">
        <div class="ofig-bar">
          <span class="ofig-bar-solid" style={`width: ${low}%;`}></span>
          <span class="ofig-bar-hatch" style={`left: ${low}%; width: ${high - low}%;`}></span>
        </div>
        <div class="ofig-ticks">
          <span class="label" style={`left: ${low}%;`}>{low}%</span>
          <span class="label" style={`left: ${high}%;`}>{high}%</span>
        </div>
        <div class="ofig-legend">
          <span class="label"><i class="key key--solid"></i>About 2 in 3 (NOAA)</span>
          <span class="label"><i class="key key--hatch"></i>Up to 9 in 10 (one study)</span>
          <span class="label"><i class="key key--empty"></i>Named</span>
        </div>
      </div>
    )}
  </div>

  <figcaption class="ofig-text">
    <span class="ofig-value">{value}</span>
    <span class="ofig-caption">{caption}</span>
    {sources.map((source) => (
      <a class="label ofig-source" href={source.href} target="_blank" rel="noopener">[ Source: {source.label} ]</a>
    ))}
  </figcaption>
</figure>

<style>
  .ofig {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-accent);
  }

  .ofig-art {
    display: flex;
    align-items: center;
    height: 11rem;
  }

  /* ---------- ring ---------- */

  .ofig-ring {
    position: relative;
    width: 11rem;
    height: 11rem;
  }

  .ofig-ring svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ring-track,
  .ring-arc {
    fill: none;
    stroke-width: 2;
  }

  .ring-track {
    stroke: var(--color-line);
  }

  .ring-arc {
    stroke: var(--color-accent);
    stroke-width: 6;
  }

  .ofig-ring-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-accent);
  }

  /* ---------- dot ---------- */

  .ofig-square {
    position: relative;
    width: 11rem;
    height: 11rem;
    border: 1px solid var(--color-text);
    background: repeating-linear-gradient(135deg, transparent 0 9px, color-mix(in srgb, var(--color-text) 10%, transparent) 9px 10px);
  }

  /* 1 px: rounded up from the true size, which would be under half a pixel */
  .ofig-seen {
    position: absolute;
    top: 62%;
    left: 70%;
    width: 1px;
    height: 1px;
    background: var(--color-orange);
  }

  .ofig-seen-ring {
    position: absolute;
    top: calc(62% - 0.6rem);
    left: calc(70% - 0.6rem);
    width: 1.2rem;
    height: 1.2rem;
    border: 1px solid var(--color-orange);
    border-radius: 50%;
  }

  .ofig-seen-label {
    position: absolute;
    top: calc(62% + 0.9rem);
    right: 0.5rem;
    padding: 0.1rem 0.3rem;
    font-size: 0.6rem;
    color: var(--color-orange);
    background: var(--color-bg);
    white-space: nowrap;
  }

  .ofig-square-label {
    position: absolute;
    top: 0.4rem;
    left: 0.5rem;
    padding: 0.1rem 0.3rem;
    font-size: 0.6rem;
    background: var(--color-bg);
    white-space: nowrap;
  }

  /* ---------- range ---------- */

  .ofig-range {
    width: 100%;
  }

  .ofig-bar {
    position: relative;
    height: 2.75rem;
    border: 1px solid var(--color-text);
  }

  .ofig-bar-solid,
  .ofig-bar-hatch {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
  }

  .ofig-bar-solid {
    background: var(--color-accent);
  }

  .ofig-bar-hatch {
    background: repeating-linear-gradient(135deg, var(--color-accent) 0 2px, transparent 2px 7px);
  }

  .ofig-ticks {
    position: relative;
    height: 1.4rem;
    margin-top: 0.3rem;
  }

  .ofig-ticks span {
    position: absolute;
    top: 0;
    translate: -50% 0;
    color: var(--color-text);
  }

  .ofig-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.6rem;
  }

  .ofig-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6rem;
  }

  .key {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border: 1px solid var(--color-text);
  }

  .key--solid {
    background: var(--color-accent);
  }

  .key--hatch {
    background: repeating-linear-gradient(135deg, var(--color-accent) 0 2px, transparent 2px 5px);
  }

  /* ---------- the text under each drawing ---------- */

  .ofig-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .ofig-value {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: clamp(2.6rem, 1rem + 3vw, 4rem);
    line-height: 0.9;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .ofig-caption {
    max-width: 24rem;
    line-height: 1.5;
  }

  .ofig-source {
    padding-block: 0.3rem; /* an easier tap target on phones */
    color: var(--color-accent);
    text-decoration: none;
  }

  .ofig-source:hover {
    text-decoration: underline;
  }

  /* ---------- compact version (Home intro) ---------- */

  .ofig--sm {
    gap: var(--space-sm);
    padding-top: var(--space-sm);
  }

  .ofig--sm .ofig-art {
    height: 7rem;
  }

  .ofig--sm .ofig-ring,
  .ofig--sm .ofig-square {
    width: 7rem;
    height: 7rem;
  }

  .ofig--sm .ofig-value {
    font-size: 1.6rem;
  }

  .ofig--sm .ofig-caption {
    font-size: var(--text-sm);
  }

  .ofig--sm .ofig-square-label,
  .ofig--sm .ofig-seen-label {
    display: none;
  }
</style>
