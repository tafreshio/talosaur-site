---
// Big title at the top of inner pages, e.g. "03 · News".
// The number matches the page's position in the top navigation.
//
// With an image (a file in public/images/pages/), the header becomes a full-width photo
// band like the Home video: the photo runs up under the menu and the title sits over its
// lower part. The page must also use <BaseLayout headerOverlay> so the menu floats on top.
// Without an image (or if the file is missing), it's the plain title with a faint glow.
import { mainNav } from '../data/site';
import { imageExists, imageUrl } from '../lib/images';
import { url } from '../lib/url';
import { keepDots } from '../lib/text';

interface Props {
  title: string;          // the page name, shown in the small label ("02 · The Problem")
  heading?: string;       // the big headline, if different from the page name
  href: string;           // the page's address, used to look up its nav number
  intro?: string;
  caption?: string;       // short line shown in [ brackets ] on a hairline under the title, e.g. '50–300 m · The twilight zone'
  image?: string;         // filename in public/images/pages/, e.g. 'news.jpg'
  imagePosition?: string; // the part of the photo to keep when a narrow screen crops it ('50% 50%' = center)
}

const { title, heading = title, href, intro, caption, image, imagePosition = '50% 50%' } = Astro.props;
const navIndex = mainNav.findIndex((item) => item.href === href);
const number = navIndex >= 0 ? String(navIndex + 1).padStart(2, '0') : null;
const hasImage = !!image && imageExists(`pages/${image}`);
const photoUrl = imageUrl(`pages/${image}`);
---

<header class:list={['page-header', { 'page-header--image': hasImage }]}>
  {hasImage && (
    <div class="page-header-media" aria-hidden="true">
      <img src={photoUrl} alt="" fetchpriority="high" style={`object-position: ${imagePosition};`} data-parallax="0.35" />
    </div>
  )}

  <div class="container page-header-inner" data-reveal-group>
    {number && <p class="label page-num">{number} · {title}</p>}
    <h1 class="page-title">{heading}</h1>
    <!-- Caption line: a hairline with a hatched stripe on the left and the caption in brackets on the right -->
    {caption && (
      <div class="page-meta">
        <span class="page-hatch" aria-hidden="true"></span>
        <p class="label page-caption">[ {keepDots(caption)} ]</p>
      </div>
    )}
    {intro && <p class="page-intro">{intro}</p>}
    <!-- Anything placed inside <PageHeader>...</PageHeader> (e.g. a button) shows here -->
    {Astro.slots.has('default') && <div class="page-actions"><slot /></div>}
  </div>
</header>

<style>
  .page-header {
    position: relative;
  }

  .page-header-inner {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  /* No photo: faint cyan glow behind the title, like light reaching down from the surface */
  .page-header:not(.page-header--image)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      50rem 20rem at 12% 0%,
      color-mix(in srgb, var(--color-accent) 12%, transparent),
      transparent 100%
    );
    pointer-events: none;
  }

  /* ---------- With a photo ---------- */

  .page-header--image {
    display: flex;
    align-items: flex-end;
    min-height: clamp(32rem, 82svh, 54rem);
    /* The menu floats on top, so pull the photo up underneath it (same as the Home hero) */
    margin-top: calc(-1 * var(--header-height));
    overflow: hidden;
    isolation: isolate; /* keeps the photo's z-index: -1 inside this header */
  }

  .page-header-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* The photo fills the band, cropping the edges (object-position picks which part stays).
     Its false-color glitch is part of the image file itself, so it's always on, like Colossal's. */
  .page-header-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: photo-in 1.4s var(--ease) both;
  }

  /* Shading so the text stays readable, without a dark band at the bottom: the photo runs
     right to its bottom edge and meets the light section below with a clean line (like
     Colossal). Only the left side, where the title and intro sit, is darkened, plus a little
     at the top behind the menu. */
  .page-header-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 18 31 / 0.62) 0%, rgb(6 18 31 / 0.38) 38%, rgb(6 18 31 / 0.08) 68%, transparent 85%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 55%, transparent) 0%, transparent 22%);
  }

  /* Phones: the text runs the full width, so shade the whole photo evenly instead */
  @media (max-width: 760px) {
    .page-header-media::after {
      background:
        linear-gradient(rgb(6 18 31 / 0.52), rgb(6 18 31 / 0.52)),
        linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 55%, transparent) 0%, transparent 22%);
    }
  }

  .page-header--image .page-header-inner {
    padding-block: calc(var(--header-height) + var(--space-xl)) var(--space-xl);
  }

  @keyframes photo-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-header-media img {
      animation: none;
    }
  }

  /* ---------- Text ---------- */

  .page-num {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
  }

  .page-title {
    max-width: 16ch;
    font-size: var(--text-hero);
  }

  .page-actions {
    margin-top: var(--space-lg);
  }

  /* ---------- Caption line ---------- */

  .page-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid color-mix(in srgb, var(--color-text) 30%, transparent);
  }

  /* The "//////" stripe: a repeating gradient that draws a 1px slanted line every 7px */
  .page-hatch {
    flex: 0 1 22rem;
    height: 0.9rem;
    background: repeating-linear-gradient(
      115deg,
      color-mix(in srgb, var(--color-text) 55%, transparent) 0 1px,
      transparent 1px 7px
    );
  }

  /* A boxed tag: a dark glassy backing keeps it readable on any photo, bright or dark */
  .page-caption {
    margin: 0 0 0 auto;
    padding: 0.35rem 0.65rem;
    text-wrap: balance; /* if it wraps, both lines get a similar length (no lone "]") */
    text-align: right;
    color: var(--color-text);
    background: rgb(6 18 31 / 0.55);
    border: 1px solid rgb(232 241 245 / 0.25);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .page-intro {
    max-width: 38rem;
    margin: var(--space-lg) 0 0;
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .page-header--image {
      min-height: clamp(30rem, 88svh, 44rem);
    }

    /* Phones: stripe on top, caption under it, both left-aligned, so long captions wrap cleanly */
    .page-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }

    .page-hatch {
      flex: none;
      width: 7rem;
    }

    .page-caption {
      margin-left: 0;
      text-align: left;
    }

    .page-intro {
      font-size: var(--text-base);
    }
  }
</style>
