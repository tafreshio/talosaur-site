---
// Photo card used on the Home page: photo on top, then a hairline, a small number,
// the title and one line of text. The whole card is clickable.
//
// Every card has the same shape, so a row of cards always lines up. If the photo file
// is missing from public/images/, a quiet dark panel of the same shape takes its place.
import { imageExists } from '../lib/images';
import { url } from '../lib/url';

interface Props {
  title: string;
  text: string;
  href: string;
  photo?: string;      // filename in public/images/
  photoLabel?: string; // what the photo shows (used as alt text)
  index?: number;      // shows a small "01", "02"... in the card
  ratio?: string;      // photo shape, e.g. '4 / 3' or '16 / 9'
  feature?: boolean;   // true = the big lead card in a feature layout (larger title)
}

const { title, text, href, photo, photoLabel = title, index, ratio = '4 / 3', feature = false } = Astro.props;
const hasPhoto = !!photo && imageExists(photo);
const isExternal = href.startsWith('http');
const isPlaceholderLink = href.startsWith('[');
const num = index !== undefined ? String(index).padStart(2, '0') : undefined;
---

<article class:list={['card', { 'card--feature': feature }]}>
  <div class="card-media" style={`aspect-ratio: ${ratio};`}>
    {hasPhoto && <img src={url(`/images/${photo}`)} alt={photoLabel} loading="lazy" decoding="async" />}
  </div>

  <div class="card-body">
    <p class="card-meta label">
      <span>{num}</span>
      {isPlaceholderLink ? (
        <span class="card-placeholder">Link: {href}</span>
      ) : (
        <span class="card-arrow" aria-hidden="true">→</span>
      )}
    </p>
    <h3 class="card-title">
      {isPlaceholderLink ? (
        title
      ) : (
        <a
          href={url(href)}
          class="card-link"
          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >{title}</a>
      )}
    </h3>
    <p class="card-text">{text}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* The photo. Its color glitch is baked into the image file (static, like the page headers). */
  .card-media {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--color-surface), var(--color-bg));
  }

  .card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover; /* fill the frame, cropping the edges if the photo is a different shape */
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
    transition: border-color var(--duration) var(--ease);
  }

  /* Small number on the left, arrow on the right */
  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    margin: 0;
    color: var(--color-accent);
  }

  .card-placeholder {
    color: var(--color-muted);
    text-align: right;
  }

  .card-arrow {
    display: inline-block;
    font-size: 1rem;
    line-height: 1;
    transition: transform var(--duration) var(--ease);
  }

  .card-title {
    font-size: clamp(1.4rem, 1.1rem + 0.9vw, 1.9rem);
    transition: color var(--duration) var(--ease);
  }

  .card-link {
    text-decoration: none;
  }

  /* Stretch the link over the whole card so anywhere on it is clickable */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-text {
    margin: 0;
    max-width: 30rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* ---------- Hover ---------- */

  /* Feature card: same parts, bigger title */
  .card--feature .card-title {
    font-size: clamp(1.8rem, 1.2rem + 1.8vw, 3rem);
  }

  .card--feature .card-text {
    font-size: var(--text-lg);
  }

  .card:hover .card-arrow {
    transform: translateX(6px);
  }

  .card:hover .card-title {
    color: var(--color-accent);
  }

  .card:hover .card-body {
    border-top-color: var(--color-accent);
  }
</style>
