---
// Card with a title, one line of text and a "Read more" link. The whole card is clickable.
// With a photo (file present in public/images/) it's a photo card; without one it's a solid
// text panel that stretches to the same height as the photo cards beside it.
import Photo from './Photo.astro';
import { imageExists } from '../lib/images';

interface Props {
  title: string;
  text: string;
  href: string;
  photo?: string;      // filename in public/images/ (optional)
  photoLabel?: string; // what the photo shows
  index?: number;      // shows a small "01", "02"... above the title
  ratio?: string;      // photo shape, e.g. '4 / 3' or '16 / 9'
}

const { title, text, href, photo, photoLabel = title, index, ratio } = Astro.props;
const hasPhoto = !!photo && imageExists(photo);
const isExternal = href.startsWith('http');
const isPlaceholderLink = href.startsWith('[');
const num = index !== undefined ? String(index).padStart(2, '0') : undefined;
---

<article class:list={['card', hasPhoto ? 'card--photo' : 'card--panel']}>
  {hasPhoto && <Photo file={photo!} label={photoLabel} ratio={ratio} />}
  <div class="card-body">
    {num && <p class="label card-num">{num}</p>}
    <h3 class="card-title">
      {isPlaceholderLink ? (
        title
      ) : (
        <a
          href={href}
          class="card-link"
          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >{title}</a>
      )}
    </h3>
    <p class="card-text">{text}</p>
    <p class="card-more" aria-hidden="true">
      {isPlaceholderLink ? <span class="label">Link: {href}</span> : <>Read more <span class="arrow">→</span></>}
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  /* Text panel: solid block, title pushed toward the bottom like the help buttons */
  .card--panel {
    min-height: 18rem;
    padding: var(--space-md);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: background var(--duration) var(--ease);
  }

  .card--panel:hover {
    background: color-mix(in srgb, var(--color-surface) 85%, var(--color-accent));
  }

  .card--panel .card-body {
    flex: 1;
  }

  .card--panel .card-title {
    margin-top: auto;
    padding-top: var(--space-lg);
  }

  .card-num {
    margin: 0;
    color: var(--color-accent);
  }

  .card-title {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem);
    line-height: 1;
    transition: color var(--duration) var(--ease);
  }

  .card-link {
    text-decoration: none;
  }

  /* Stretch the link over the whole card so anywhere is clickable */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-text {
    margin: 0;
    color: var(--color-muted);
  }

  .card-more {
    margin: var(--space-xs) 0 0;
    font-weight: 600;
    color: var(--color-accent);
  }

  .arrow {
    display: inline-block;
    transition: transform var(--duration) var(--ease);
  }

  .card:hover .arrow {
    transform: translateX(4px);
  }

  .card:hover :global(.photo img) {
    transform: scale(1.04);
  }

  .card:hover .card-title {
    color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .card--panel {
      min-height: 0;
    }

    .card--panel .card-title {
      padding-top: var(--space-md);
    }
  }
</style>
