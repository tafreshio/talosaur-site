---
// Top of each section: a hairline, "Section 0X" on the left, and the big uppercase heading.
// Anything placed inside <SectionHeader>...</SectionHeader> (for example an "All news" link)
// sits on the right, in line with the heading.
interface Props {
  number: number;
  title?: string;
}

const { number, title } = Astro.props;
---

<header class="section-header" data-reveal>
  <p class="label section-num">Section {String(number).padStart(2, '0')}</p>
  {title && <h2 class="section-title">{title}</h2>}
  {Astro.slots.has('default') && <div class="section-aside"><slot /></div>}
</header>

<style>
  .section-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-sm) var(--space-lg);
    margin-bottom: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
  }

  .section-num {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-accent);
  }

  .section-title {
    font-size: var(--text-2xl);
  }

  /* Right-hand link, sits on the same baseline as the heading */
  .section-aside {
    padding-bottom: 0.35em;
  }

  @media (max-width: 600px) {
    .section-header {
      grid-template-columns: 1fr;
    }

    .section-aside {
      padding-bottom: 0;
    }
  }
</style>
