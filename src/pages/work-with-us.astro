---
// Work with us: the contact page. Email and location come from src/data/site.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Patch from '../components/Patch.astro';
import { url } from '../lib/url';
import { imageUrl } from '../lib/images';
import { teamEmail, location, contactHref } from '../data/site';

const intro =
  "Do you work with marine life between 50 and 300 meters, in research, conservation, fisheries or offshore energy? We'd love a 20-minute conversation about how you study it today.";

const emailHref = contactHref(teamEmail);
---

<BaseLayout title="Work with us" description={intro} headerOverlay>
  <PageHeader title="Work with us" heading="Get in touch" href="/work-with-us" intro={intro} caption="Research · Conservation · Fisheries · Offshore" image="work-with-us.jpg" imagePosition="80% 50%" />

  <!-- Light band: everything below the photo header -->
  <div class="band band--top theme-light">
    <section class="container contact-layout">
      <dl class="contact-list" data-reveal-group>
        <div class="contact-row">
          <dt class="label">Email</dt>
          <dd>
            {emailHref ? (
              <a class="contact-value contact-email" href={emailHref}>{teamEmail} <span aria-hidden="true">→</span></a>
            ) : (
              <span class="contact-value contact-placeholder">{teamEmail}</span>
            )}
          </dd>
        </div>
        <div class="contact-row">
          <dt class="label">Location</dt>
          <dd><span class="contact-value">{location}</span></dd>
        </div>
      </dl>

      <!-- Collage beside the contact details, in the style of Colossal's species pages: a big edited
           photo (jellyfish in a magenta and orange map), a lime colour block behind it with a notch
           cut out, an orange dot on one corner and a small natural photo over another.
           Pictures: public/images/accents/jelly.jpg and ship-inset.jpg. -->
      <figure class="collage" aria-hidden="true" data-drift="50">
        <span class="collage-block"></span>
        <img class="collage-main" src={imageUrl('accents/jelly.jpg')} alt="" width="1280" height="960" loading="lazy" decoding="async" />
        <span class="collage-dot"></span>
        <span class="label collage-tag">[ Jellyfish ]</span>
        <img class="collage-inset" src={imageUrl('accents/ship-inset.jpg')} alt="" width="900" height="600" loading="lazy" decoding="async" />
      </figure>
    </section>
  </div>

  <!-- Inset photo sitting across the edge between the contact details and the photo below -->
  <Patch variant="strip" image="wake-tall.jpg" caption="Under way" side="right" straddle />

  <!-- One big photo (anemone, false colour) leading on to Donate. Copy: the Donate page heading. -->
  <PhotoBand image="work-with-us.jpg" position="50% 50%" heading="Support our research" tag="Parts · Testing · Field trips">
    <a class="button" href={url('/donate')}>Donate <span aria-hidden="true">→</span></a>
  </PhotoBand>
</BaseLayout>

<style>
  /* Contact details on the left, the collage on the right */
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-xl);
    align-items: start;
  }

  /* ---------- Collage ---------- */

  .collage {
    position: relative;
    margin: var(--space-md) 0 var(--space-xl) var(--space-lg);
  }

  /* Lime block behind the photo, poking out at the top left, with a notch cut from its bottom right */
  .collage-block {
    position: absolute;
    top: calc(-1 * var(--space-md));
    left: calc(-1 * var(--space-lg));
    width: 72%;
    height: calc(100% + var(--space-lg));
    background: var(--color-lime);
    clip-path: polygon(0 0, 100% 0, 100% 62%, 58% 62%, 58% 100%, 0 100%);
  }

  .collage-main {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .collage-dot {
    position: absolute;
    top: -0.55rem;
    right: -0.55rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--color-orange);
  }

  .collage-tag {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: 0.3rem 0.55rem;
    color: var(--color-white);
    background: rgb(6 18 31 / 0.6);
  }

  /* Small natural photo over the bottom left corner */
  .collage-inset {
    position: absolute;
    left: calc(-1 * var(--space-md));
    bottom: calc(-1 * var(--space-xl));
    width: 42%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 3px solid var(--light-bg);
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.2);
  }

  .contact-list {
    margin: 0;
    border-bottom: 1px solid var(--color-line);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    align-items: baseline;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  .contact-row dd {
    margin: 0;
    min-width: 0;
  }

  /* Big, Colossal-style contact details */
  .contact-value {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: clamp(2rem, 1rem + 4vw, 4.5rem);
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere; /* long email addresses wrap instead of overflowing */
  }

  .contact-email {
    color: var(--color-accent);
    text-decoration: none;
    text-transform: none;
  }

  .contact-email span {
    display: inline-block;
    transition: transform var(--duration) var(--ease);
  }

  .contact-email:hover span {
    transform: translateX(6px);
  }

  .contact-placeholder {
    color: var(--color-muted);
    text-transform: none;
  }

  /* Tablet and phone: the collage goes under the contact details */
  @media (max-width: 1199px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .collage {
      width: min(34rem, 88%);
      margin: var(--space-md) 0 calc(var(--space-xl) + var(--space-md)) auto;
    }
  }

  @media (max-width: 700px) {
    .contact-row {
      grid-template-columns: 1fr;
    }

    .collage-block {
      top: calc(-1 * var(--space-sm));
      left: calc(-1 * var(--space-md));
    }

    .collage-inset {
      left: calc(-1 * var(--space-sm));
      bottom: calc(-1 * var(--space-lg));
    }
  }
</style>
