---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatCallout from '../components/StatCallout.astro';
import DepthBands from '../components/DepthBands.astro';
import PhotoBand from '../components/PhotoBand.astro';
import SpecList from '../components/SpecList.astro';
import StoryBand from '../components/StoryBand.astro';
import PictureCards from '../components/PictureCards.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Statement from '../components/Statement.astro';
import Roadmap from '../components/Roadmap.astro';
import { url } from '../lib/url';
import { imageExists, imageUrl } from '../lib/images';
import { problemIntro, stats, habitat, glance, fgbStats, fgbSpecies, sources, plan } from '../data/problem';
---

<BaseLayout title="The Problem" description={problemIntro} headerOverlay>
  <PageHeader
    title="The Problem"
    heading="The gap in the water column"
    href="/the-problem"
    intro={problemIntro}
    caption="50–300 m · The twilight zone" image="the-problem.jpg"
    imagePosition="50% 30%"
  />

  <!-- Light band: the big numbers. It ends where the sea (Section 02) begins. -->
  <div class="band theme-light sky">
    <!-- Section 01: big numbers (drifts a little as you scroll, see BaseLayout) -->
    <section class="container section" data-drift="60">
      <SectionHeader number={1} />
      <div class="stats" data-reveal-group>
        {stats.map((stat, i) => <StatCallout {...stat} index={i + 1} />)}
      </div>
    </section>

    <!-- Section 02 label sits just above the water line -->
    <div class="container section">
      <SectionHeader number={2} />
    </div>
  </div>

  <!-- Section 02: the sea itself, drawn to scale. The three reasons it is hard to study
       (Content doc) sit inside it at the depths they are about. -->
  <DepthBands />

  <!-- Section 03: At a glance. It carries on the dark water of the depth graphic above, so the page
       goes light, dark, light, dark. Colossal's fact sheet: white boxed labels and a big cut-out. -->
  <div class="band">
    <section class="container section">
      <SectionHeader number={3} title="At a glance" />
      <SpecList items={glance} image="glance-jelly.webp" width={1745} height={939} />
    </section>
  </div>

  <!-- Section 04: Habitat (light). Like the "Habitat / Arctic + Tundra" section on Colossal's mammoth
       page: a wide strip of the reef, the place in big type, a short text and a map. -->
  <div class="band theme-light">
    <section class="container section habitat">
      <SectionHeader number={4} title="Habitat" />
      <!-- A wide picture of the reef at Flower Garden Banks (sections/habitat-pano.jpg, 1800 x 900): a big
           brain coral on its pedestal of reef, photo supplied by the team. If the file is missing, a
           "photo to come" panel says what goes there. -->
      <div class="habitat-pano">
        {imageExists('sections/habitat-pano.jpg') ? (
          <>
            <img src={imageUrl('sections/habitat-pano.jpg')} alt="A large brain coral on a pedestal of reef at Flower Garden Banks" width="1800" height="900" loading="lazy" decoding="async" />
            <span class="label habitat-tag" aria-hidden="true">[ Brain coral · Flower Garden Banks ]</span>
          </>
        ) : (
          <PhotoPlaceholder label="the reef at Flower Garden Banks" file="sections/habitat-pano.jpg" />
        )}
      </div>
      <div class="habitat-grid">
        <div class="habitat-copy" data-reveal>
          <h3 class="habitat-title">{habitat.title}</h3>
          {habitat.paragraphs.map((text) => <p class="habitat-text">{text}</p>)}
          <dl class="habitat-facts">
            {habitat.facts.map((fact) => (
              <div class="habitat-fact">
                <dt class="label">{fact.label}</dt>
                <dd>
                  {fact.value}
                  {fact.source && <a class="label habitat-src" href={fact.source.href} target="_blank" rel="noopener">[ {fact.source.label} ]</a>}
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <!-- Map of the coast: Flower Garden Banks in magenta, College Station as a dot.
             The labels sit at the same spots as on the picture (left %, top %). -->
        <figure class="habitat-map" data-drift="50">
          <img src={imageUrl('sections/habitat-map.png')} alt="Map of the Texas and Louisiana coast with Flower Garden Banks offshore and College Station inland" width="1600" height="1100" loading="lazy" decoding="async" />
          <span class="map-pin map-pin--fgb" style="left: 50.3%; top: 65.1%;"><span class="label">Flower Garden Banks</span></span>
          <span class="map-pin map-pin--home" style="left: 25.4%; top: 21.9%;"><span class="label">College Station</span></span>
        </figure>
      </div>
    </section>
  </div>

  <!-- Story band: Flower Garden Banks in numbers beside the drawing from the front of NOAA's 2023
       sanctuary poster (sections/fgb-poster-art.jpg, cropped only, never recoloured). Behind it, the bank's
       seafloor relief (a NOAA graphic from the same poster) in violet and lime. Facts: the same poster. -->
  <StoryBand
    variant="art"
    image="story-fgb.jpg"
    position="50% 60%"
    tag="Flower Garden Banks"
    title="Most of it lies in the twilight zone"
    items={fgbStats}
    art={{
      image: 'sections/fgb-poster-art.jpg',
      width: 1600,
      height: 1524,
      alt: 'Drawing of Flower Garden Banks: a manta ray and a whale shark overhead, a remotely operated vehicle lighting the water, and a grouper, angelfish and brain coral on the reef',
      //   is a space that never breaks, so no name splits across two lines
      credit: "NOAA's 2023 sanctuary poster · Art: Kathryn Robertson, Matt McIntosh / NOAA, Melissa Cook",
    }}
    source={sources.poster}
  />

  <!-- Section 05: who lives here, four animals from the poster with NOAA photos (natural colour) -->
  <div class="band band--top theme-light">
    <section class="container species">
      <SectionHeader number={5} title="Who lives here" />
      <PictureCards items={fgbSpecies} columns={4} ratio="4 / 3" />
    </section>

    <!-- Section 06: what we're doing about it. A big statement, then the plan as a dive: four steps,
         each a little deeper, from Turtle in fresh water to the twilight zone (plan in src/data/problem.ts).
         id="plan" so other pages can link straight here (/the-problem#plan). -->
    <section class="container section plan" id="plan">
      <SectionHeader number={6} title="What we're doing" />
      <Statement tag={plan.tag} headline={plan.headline} text={plan.text} />
      <div class="plan-roadmap">
        <Roadmap steps={plan.steps} depth={plan.depth} />
      </div>

      <!-- What we'll offer once it works: vehicles to buy, research to use, surveys on request.
           A dark panel with a lime corner square, like the founder's description box on Who we are. -->
      <div class="offer" id="offer">
        <div class="offer-head" data-reveal>
          <p class="label offer-tag">[ {plan.offer.tag} ]</p>
          <h3 class="offer-title">{plan.offer.title}</h3>
        </div>
        <ol class="offer-list" data-reveal-group>
          {plan.offer.items.map((item, i) => (
            <li class="offer-item">
              <p class="label offer-item-tag"><span class="offer-letter">{String.fromCharCode(65 + i)}</span> {item.tag}</p>
              <h4 class="offer-item-title">{item.title}</h4>
              <p class="offer-item-text">{item.text}</p>
            </li>
          ))}
        </ol>
        <a class="button offer-cta" href={url(plan.offer.cta.href)}>{plan.offer.cta.label} <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>

  <!-- Closing photo (octopus on a reef, in the teal-sand-magenta colour sweep). Copy: Content doc Home headline and "Get in touch" card. -->
  <PhotoBand image="the-problem.jpg" position="70% 50%" heading="Life at 50–300 m is barely watched." size="md" tag="Researchers · Sanctuaries · Offshore teams">
    <a class="button" href={url('/work-with-us')}>Get in touch <span aria-hidden="true">→</span></a>
  </PhotoBand>
</BaseLayout>

<style>
  .section {
    padding-top: var(--space-2xl);
  }

  /* The light band stops a short way under the Section 02 label, leaving room for the ship's mast */
  .sky {
    padding-bottom: var(--space-xl);
  }

  /* ---------- Stats ---------- */

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  /* ---------- Section 03: Habitat ---------- */

  .habitat-pano {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .habitat-pano img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .habitat-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-white);
    background: rgb(6 18 31 / 0.6);
  }

  .species {
    padding-top: var(--space-lg);
  }

  /* the fixed header shouldn't cover the section heading when you land on /the-problem#plan */
  .plan {
    scroll-margin-top: var(--header-height);
  }

  .plan-roadmap {
    margin-top: var(--space-2xl);
  }

  /* ---------- What we'll offer ---------- */

  .offer {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-lg) var(--space-xl);
    margin-top: var(--space-2xl);
    padding: clamp(1.75rem, 4vw, 4rem);
    color: var(--light-bg);
    background: var(--light-text);
    scroll-margin-top: calc(var(--header-height) + 1rem);
    /* inside the panel, labels, lines and the button switch to their versions for dark */
    --color-muted: #8fa8b8;
    --color-line: rgb(232 241 245 / 0.25);
    --color-accent: #3de0d0;
    --color-accent-ink: #06121f;
  }

  /* lime square on the corner, as on the founder's box */
  .offer::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: -0.5rem;
    width: 1rem;
    height: 1rem;
    background: var(--color-lime);
  }

  .offer-tag {
    margin: 0;
    color: var(--color-lime);
  }

  .offer-title {
    margin-top: var(--space-sm);
    font-size: var(--text-2xl);
    line-height: 0.95;
    color: var(--light-bg);
  }

  .offer-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .offer-item {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
  }

  .offer-item-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .offer-letter {
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    color: var(--light-text);
    background: var(--color-orange);
  }

  /* the same big condensed capitals as the other headings (h4 isn't styled site-wide) */
  .offer-item-title {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: clamp(1.4rem, 1rem + 0.9vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--light-bg);
  }

  .offer-item-text {
    margin: var(--space-xs) 0 0;
    line-height: 1.5;
  }

  .offer-cta {
    grid-column: 2;
    justify-self: start;
  }

  @media (max-width: 1023px) {
    .offer {
      grid-template-columns: 1fr;
    }

    .offer-cta {
      grid-column: auto;
    }
  }

  @media (max-width: 760px) {
    .offer-list {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    /* the lime square sits inside the page margin */
    .offer::before {
      left: 0;
    }
  }

  .habitat-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
    margin-top: var(--space-xl);
  }

  .habitat-title {
    font-size: clamp(2.5rem, 1rem + 5vw, 5.5rem);
    line-height: 0.92;
  }

  .habitat-text {
    margin: var(--space-md) 0 0;
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .habitat-facts {
    margin: var(--space-lg) 0 0;
  }

  .habitat-fact {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--color-line);
  }

  .habitat-fact dt {
    color: var(--color-muted);
  }

  .habitat-fact dd {
    margin: 0;
    font-weight: 600;
  }

  .habitat-src {
    display: inline-block;
    padding-block: 0.3rem; /* an easier tap target on phones */
    margin-left: 0.5rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .habitat-map {
    position: relative;
    margin: 0;
  }

  .habitat-map img {
    width: 100%;
    height: auto;
  }

  /* Labels on the map: a dot with a small boxed tag beside it */
  .map-pin {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: translate(-0.4rem, -50%);
  }

  .map-pin::before {
    content: '';
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 0 3px var(--light-bg);
  }

  .map-pin--fgb::before {
    background: var(--color-magenta);
  }

  .map-pin .label {
    padding: 0.2rem 0.45rem;
    color: var(--light-bg);
    background: var(--light-text);
    white-space: nowrap;
  }

  /* ---------- Tablet and phone ---------- */

  @media (max-width: 1023px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }

    .habitat-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr;
    }

    /* a little taller on phones, trimming the sides so the coral stays big */
    .habitat-pano {
      aspect-ratio: 16 / 10;
    }

    /* the tag moves to the bottom so it doesn't sit on top of the coral */
    .habitat-tag {
      top: auto;
      bottom: 0.6rem;
      left: 0.6rem;
    }

    .habitat-text {
      font-size: var(--text-base);
    }

    .habitat-fact {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .map-pin .label {
      font-size: 0.6rem;
    }
  }
</style>
