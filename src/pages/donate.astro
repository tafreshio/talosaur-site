---
// Donate: ways to help plus a contact button. No online payments.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Patch from '../components/Patch.astro';
import PictureCards from '../components/PictureCards.astro';
import { financeContact, contactHref } from '../data/site';
import { imageUrl } from '../lib/images';

const intro =
  'Talosaur is student-built and runs on a tight budget. Your support funds parts, testing and field trips, and helps us bring affordable ocean exploration to more people.';

// Each way to help has a tile on top: an animal from NOAA Ocean Exploration dive video, edited in
// Colossal's colour blocks (public/images/accents/). "animal" is the small tag on the tile.
const waysToHelp = [
  { title: 'Fund research', text: 'Support a specific study or field test', image: 'tile-coral.jpg', animal: 'Iridogorgia coral' },
  { title: 'Sponsor a project', text: 'Back a build like Turtle or our eDNA sampler', image: 'tile-sea-pen.jpg', animal: 'Sea pen' },
  { title: 'Give in kind', text: 'Parts, equipment, pool or boat time', image: 'tile-ray.jpg', animal: 'Ray' },
];

// Where it goes: parts, testing and field trips (the header's caption), each with a photo that goes
// with it (public/images/sections/, natural colour). Text in [brackets] is a placeholder to fill in later.
const support = [
  { image: 'support-parts.jpg', tag: 'Machining', title: 'Parts', text: '[What a gift buys here, for example materials and parts for the next build.]' },
  { image: 'support-testing.jpg', tag: 'NOAA', title: 'Testing', text: '[What testing costs, for example pool time or a day on the lake.]' },
  { image: 'support-field-trips.jpg', tag: 'Under way', title: 'Field trips', text: '[What a field trip costs, for example boat time and travel to the coast.]' },
];

const financeHref = contactHref(financeContact);
---

<BaseLayout title="Donate" description={intro} headerOverlay>
  <PageHeader title="Donate" heading="Support our research" href="/donate" intro={intro} caption="Parts · Testing · Field trips" image="donate.jpg" imagePosition="40% 50%" />

  <!-- Light band: everything below the photo header -->
  <div class="band band--top theme-light">
    <section class="container">
      <SectionHeader number={1} title="Ways to help" />
      <ol class="ways" data-reveal-group>
        {waysToHelp.map((way, i) => (
          <li class="way">
            <figure class="way-tile" aria-hidden="true">
              <img src={imageUrl(`accents/${way.image}`)} alt="" width="900" height="675" loading="lazy" decoding="async" />
              <span class="label way-tag">[ {way.animal} · NOAA ]</span>
            </figure>
            <p class="label way-num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="way-title">{way.title}</h3>
            <p class="way-text">{way.text}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <!-- Inset photo sitting across the edge between the ways to help and the dark band below -->
  <Patch variant="stack" images={['stack-shrimp.jpg', 'stack-anemone.jpg']} caption="NOAA footage" side="right" straddle />

  <!-- Dark band: where it goes, three photo cards -->
  <div class="band">
    <section class="container where">
      <SectionHeader number={2} title="Where it goes" />
      <PictureCards items={support} columns={3} />
    </section>
  </div>

  <!-- One big photo (zoanthids and a sea slug, false colour) carrying the contact button and note -->
  <PhotoBand image="donate.jpg" position="55% 50%" heading="Your support funds parts, testing and field trips." size="md">
    <div class="contact-box">
      {financeHref ? (
        <a class="button" href={financeHref}>Contact our finance team <span aria-hidden="true">→</span></a>
      ) : (
        <span class="button button--disabled" aria-disabled="true">Contact our finance team</span>
      )}
      {!financeHref && <p class="label">Link: {financeContact}</p>}
      <p class="contact-note">No online payments on the site for now; every donation starts with a conversation.</p>
    </div>
  </PhotoBand>
</BaseLayout>

<style>
  .where {
    padding-top: var(--space-2xl);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each way to help is a column: a colour tile, then a thin line, the number and the text */
  .way {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .way-tile {
    position: relative;
    margin: 0 0 var(--space-xs);
  }

  .way-tile img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* the small square on the tile's corner, a different colour per tile (Colossal's corner dots) */
  .way-tile::after {
    content: '';
    position: absolute;
    right: -0.45rem;
    bottom: -0.45rem;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--color-orange);
  }

  .way:nth-child(2) .way-tile::after {
    background: var(--color-lime);
  }

  .way:nth-child(3) .way-tile::after {
    background: var(--color-violet);
  }

  .way-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-white);
    background: rgb(6 18 31 / 0.6);
  }

  .way-num {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-accent);
  }

  .way-num {
    margin: 0;
    color: var(--color-accent);
  }

  .way-title {
    font-size: var(--text-xl);
  }

  .way-text {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .contact-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .button--disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .contact-note {
    max-width: 38rem;
    margin: var(--space-sm) 0 0;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .ways {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    /* tiles a little shorter on phones so the three ways don't take several screens */
    .way-tile img {
      aspect-ratio: 16 / 9;
    }

    .way-text {
      font-size: var(--text-base);
    }
  }
</style>
