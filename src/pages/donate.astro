---
// Donate: ways to help plus a contact button. No online payments.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Patch from '../components/Patch.astro';
import { financeContact, contactHref } from '../data/site';

const intro =
  'Talosaur is student-built and runs on a tight budget. Your support funds parts, testing and field trips, and helps us bring affordable ocean exploration to more people.';

const waysToHelp = [
  { title: 'Fund research', text: 'Support a specific study or field test' },
  { title: 'Sponsor a project', text: 'Back a build like Turtle or our eDNA sampler' },
  { title: 'Give in kind', text: 'Parts, equipment, pool or boat time' },
];

const financeHref = contactHref(financeContact);
---

<BaseLayout title="Donate" description={intro} headerOverlay>
  <PageHeader title="Donate" heading="Support our research" href="/donate" intro={intro} caption="Parts · Testing · Field trips" image="donate.jpg" imagePosition="40% 50%" />

  <!-- Light band: everything below the photo header -->
  <div class="band band--top theme-light">
    <section class="container">
      <SectionHeader number={1} title="Ways to help" />
      <ol class="ways" data-reveal-group>
        {waysToHelp.map((way, i) => (
          <li class="way">
            <p class="label way-num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="way-title">{way.title}</h3>
            <p class="way-text">{way.text}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <!-- Inset photo sitting across the edge between the ways to help and the photo below -->
  <Patch image="lathe.jpg" caption="Making parts" side="right" straddle />

  <!-- One big photo (zoanthids and a sea slug, false colour) carrying the contact button and note -->
  <PhotoBand image="donate.jpg" position="55% 50%" heading="Support our research">
    <div class="contact-box">
      {financeHref ? (
        <a class="button" href={financeHref}>Contact our finance team <span aria-hidden="true">→</span></a>
      ) : (
        <span class="button button--disabled" aria-disabled="true">Contact our finance team</span>
      )}
      {!financeHref && <p class="label">Link: {financeContact}</p>}
      <p class="contact-note">No online payments on the site for now; every donation starts with a conversation.</p>
    </div>
  </PhotoBand>
</BaseLayout>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each way to help is a column with a thin line on top */
  .way {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-accent);
  }

  .way-num {
    margin: 0;
    color: var(--color-accent);
  }

  .way-title {
    font-size: var(--text-xl);
  }

  .way-text {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .contact-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .button--disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .contact-note {
    max-width: 38rem;
    margin: var(--space-sm) 0 0;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .ways {
      grid-template-columns: 1fr;
    }

    .way-text {
      font-size: var(--text-base);
    }
  }
</style>
