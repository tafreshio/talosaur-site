---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Image credits">
  <section class="container simple-page">
    <p class="label">Image credits</p>
    <h1>Image credits</h1>
    <div class="prose">
      <p>The photos, graphics and the homepage video on this site were provided by the Talosaur team.</p>
      <!-- PLACEHOLDER: list any third-party footage or photos here, with the creator and licence -->
      <p>[Credits for any third-party footage or photos used in the homepage video.]</p>
    </div>
  </section>
</BaseLayout>

<style>
  .simple-page {
    padding-block: var(--space-2xl) 0;
  }

  h1 {
    margin-block: var(--space-sm) var(--space-lg);
    font-size: var(--text-2xl);
  }

  .prose {
    max-width: 60ch;
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .prose p {
    margin: 0 0 var(--space-md);
    color: var(--color-muted);
  }
</style>
