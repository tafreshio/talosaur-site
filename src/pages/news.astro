---
// News page: every entry in src/content/news/, newest first.
// To add an update, add a Markdown file to that folder (see README).
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import PhotoBand from '../components/PhotoBand.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PictureCards from '../components/PictureCards.astro';
import { twitchUrl } from '../data/site';
import { getSortedNews, formatNewsDate } from '../lib/news';
import { imageExists, imageUrl } from '../lib/images';

const entries = await getSortedNews();

// Where we test: the steps from the pool down to the reef, each with a photo that goes with it
// (public/images/sections/test-*.jpg, stock stand-ins until the team has its own; the tag on each
// says what that photo should show). Text in [brackets] is a placeholder to fill in later.
const tests = [
  { image: 'test-pool.jpg', tag: 'Photo: pool test', title: 'Pool', text: '[When, and what this test shows.]' },
  { image: 'test-lake.jpg', tag: 'Photo: lake test', title: 'Lake', text: '[When, and what this test shows.]' },
  { image: 'test-gulf.jpg', tag: 'Photo: out on the Gulf', title: 'Gulf of Mexico', text: '[When, and what this test shows.]' },
  { image: 'test-reef.jpg', tag: 'Photo: first reef footage', title: 'Flower Garden Banks', text: '[When, and what we hope to film there.]' },
];

// Heights (0 = top, 1 = bottom) of the four photos on the field log strip. They match the picture,
// so only change them if you remake news-rail.jpg.
const railStops = [0.12, 0.37, 0.62, 0.86];

// Turn each entry's Markdown body into HTML we can place on the page
const items = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    hasPhoto: !!entry.data.image && imageExists(`news/${entry.data.image}`),
  })),
);
---

<BaseLayout title="News" headerOverlay>
  <PageHeader title="News" href="/news" caption="Field log · Turtle, phase 1" image="news.jpg" imagePosition="47% 50%" />

  <!-- Light band: everything below the photo header -->
  <div class="band band--top theme-light">
    <section class="container news-layout">
      <!-- The same field log strip lying on its side, above the list on phones and tablets
           (public/images/accents/news-rail-wide.jpg). The tall one beside the list is for wide screens. -->
      <figure class="field-log field-log--wide" aria-hidden="true">
        <div class="field-log-strip">
          <img src={imageUrl('accents/news-rail-wide.jpg')} alt="" width="1600" height="440" loading="lazy" decoding="async" />
          {railStops.map((stop, i) => (
            <span class="label field-log-dot" style={`left: ${stop * 100}%; top: 15.9%`}>{String(i + 1).padStart(2, '0')}</span>
          ))}
        </div>
      </figure>

      <ol class="news-list" data-reveal-group>
        {items.map(({ entry, Content, hasPhoto }) => (
          <li id={entry.id} class:list={['news-item', { 'news-item--has-photo': hasPhoto }]}>
            <p class:list={['label', 'news-date', { 'news-date--upcoming': entry.data.upcoming }]}>
              {entry.data.date
                ? <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatNewsDate(entry)}</time>
                : formatNewsDate(entry)}
            </p>
            <div class="news-body">
              <h2 class="news-title">{entry.data.title}</h2>
              <div class="news-text"><Content /></div>
            </div>
            {hasPhoto && (
              <div class="news-photo">
                <Photo file={`news/${entry.data.image}`} label={entry.data.title} ratio="4 / 3" />
              </div>
            )}
          </li>
        ))}
      </ol>

      <!-- Field log strip beside the list (wide screens only), like the timelines on Colossal's
           species pages: lime at the top (the surface) to violet at the bottom (deeper), with four
           photos from NOAA dive video. The picture is public/images/accents/news-rail.jpg;
           the numbered dots below sit on its line at the heights the photos were drawn at. -->
      <figure class="field-log" aria-hidden="true">
        <div class="field-log-strip">
          <img src={imageUrl('accents/news-rail.jpg')} alt="" width="480" height="1600" loading="lazy" decoding="async" />
          {railStops.map((stop, i) => (
            <span class="label field-log-dot" style={`left: 13.3%; top: ${stop * 100}%`}>{String(i + 1).padStart(2, '0')}</span>
          ))}
        </div>
        <figcaption class="label field-log-tag">[ Field log · NOAA ]</figcaption>
      </figure>
    </section>

    <!-- Section 01: where we test, from the pool down to the reef (four photo cards) -->
    <section class="container tests">
      <SectionHeader number={1} title="Where we test" />
      <PictureCards items={tests} columns={4} />
    </section>
  </div>

  <!-- Closing photo (moray eel, thermal false colour). Copy: Content doc, "Talosaur Live" card. -->
  <PhotoBand image="news.jpg" position="40% 50%" heading="Talosaur Live" tag="Join the live build stream and see our engineers at work">
    <a class="button" href={twitchUrl} target="_blank" rel="noopener noreferrer">Watch on Twitch <span aria-hidden="true">↗</span></a>
  </PhotoBand>
</BaseLayout>

<style>
  .tests {
    padding-top: var(--space-2xl);
  }

  /* The list on the left, the field log strip on the right (wide screens) */
  .news-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(11rem, 15vw, 15rem);
    gap: var(--space-xl);
    align-items: start;
  }

  .field-log {
    margin: 0;
  }

  /* the dots are placed in % of this box, which is exactly the picture */
  .field-log-strip {
    position: relative;
  }

  .field-log img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Numbered dots on the strip's line (where they go is set on each dot in the markup) */
  .field-log-dot {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--light-text);
    transform: translate(-50%, -50%);
  }

  .field-log-tag {
    margin-top: var(--space-sm);
    color: var(--color-muted);
  }

  /* the sideways strip is only for narrower screens */
  .field-log--wide {
    display: none;
  }

  /* Narrower screens: the list takes the whole width, with the sideways strip above it */
  @media (max-width: 1099px) {
    .news-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .field-log {
      display: none;
    }

    .field-log--wide {
      display: block;
    }
  }

  @media (max-width: 760px) {
    .field-log--wide .field-log-dot {
      width: 1.5rem;
      height: 1.5rem;
      font-size: 0.6rem;
    }
  }

  .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-line);
  }

  /* Each entry is a row: date | title and text | photo (if any) */
  .news-item {
    display: grid;
    grid-template-columns: 12rem 1fr;
    align-items: start;
    gap: var(--space-md) var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-line);
    /* When you arrive from a Home page link, leave room for the sticky header */
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .news-item--has-photo {
    grid-template-columns: 12rem 1fr minmax(0, 22rem);
  }

  /* Briefly highlight the entry you jumped to from the Home page */
  .news-item:target .news-title {
    color: var(--color-accent);
  }

  .news-date {
    margin: 0.4rem 0 0;
    color: var(--color-accent);
  }

  /* "Coming soon" gets a small outlined badge */
  .news-date--upcoming {
    justify-self: start; /* don't stretch to the width of the date column */
    width: fit-content;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
  }

  .news-title {
    font-size: var(--text-xl);
  }

  .news-text {
    max-width: 38rem;
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .news-text :global(p) {
    margin: 0;
  }

  .news-text :global(p + p) {
    margin-top: var(--space-sm);
  }

  /* Phone: stack date, text and photo */
  @media (max-width: 760px) {
    .news-item,
    .news-item--has-photo {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .news-date {
      margin: 0;
    }

    .news-text {
      font-size: var(--text-base);
    }

    .news-photo {
      margin-top: var(--space-sm);
    }
  }
</style>
