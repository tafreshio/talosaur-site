---
// News page: every entry in src/content/news/, newest first.
// To add an update, add a Markdown file to that folder (see README).
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import { getSortedNews, formatNewsDate } from '../lib/news';

const entries = await getSortedNews();

// Turn each entry's Markdown body into HTML we can place on the page
const items = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="News">
  <PageHeader title="News" href="/news" />

  <section class="container">
    <ol class="news-list">
      {items.map(({ entry, Content }) => (
        <li id={entry.id} class:list={['news-item', { 'news-item--has-photo': entry.data.image }]}>
          <p class="label news-date">
            {entry.data.date
              ? <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatNewsDate(entry)}</time>
              : formatNewsDate(entry)}
          </p>
          <div class="news-body">
            <h2 class="news-title">{entry.data.title}</h2>
            <div class="news-text"><Content /></div>
          </div>
          {entry.data.image && (
            <div class="news-photo">
              <Photo file={`news/${entry.data.image}`} label={entry.data.title} ratio="4 / 3" />
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-line);
  }

  /* Each entry is a row: date | title and text | photo (if any) */
  .news-item {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-md) var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-line);
    /* When you arrive from a Home page link, leave room for the sticky header */
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .news-item--has-photo {
    grid-template-columns: 12rem 1fr minmax(0, 22rem);
  }

  /* Briefly highlight the entry you jumped to from the Home page */
  .news-item:target .news-title {
    color: var(--color-accent);
  }

  .news-date {
    margin: 0.4rem 0 0;
    color: var(--color-accent);
  }

  .news-title {
    font-size: var(--text-xl);
  }

  .news-text {
    max-width: 38rem;
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .news-text :global(p) {
    margin: 0;
  }

  .news-text :global(p + p) {
    margin-top: var(--space-sm);
  }

  /* Phone: stack date, text and photo */
  @media (max-width: 760px) {
    .news-item,
    .news-item--has-photo {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .news-date {
      margin: 0;
    }

    .news-text {
      font-size: var(--text-base);
    }

    .news-photo {
      margin-top: var(--space-sm);
    }
  }
</style>
