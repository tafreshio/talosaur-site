---
// Who we are: the team, in the style of the people sections on Colossal's Company page.
//   - The lead (lead: true in src/data/team.ts) gets a row of their own: a big portrait with their name
//     in violet boxes over its corner, and a description box beside it (like Colossal's chairman feature).
//   - Everyone else is a staggered collage below: cards of different sizes, columns at different
//     heights, colour blocks and frames offset behind the photos, and each card drifting at its own
//     speed as you scroll.
//   - The collage is split in two rows of three. Between them: a slow strip of the team's disciplines
//     (taken from the roles) and a few lines about the team as a whole (teamStatement in team.ts).
//
// Team members are listed in src/data/team.ts. A member with a photo in public/images/team/ gets a
// photo card; without one, a plain panel with their initials. People's photos stay natural (no colour
// edits): the colour is only in the blocks behind them.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Patch from '../components/Patch.astro';
import StoryBand from '../components/StoryBand.astro';
import { url } from '../lib/url';
import Photo from '../components/Photo.astro';
import Marquee from '../components/Marquee.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { team, teamIntro, teamStatement } from '../data/team';
import { isPlaceholder } from '../data/site';
import { imageExists } from '../lib/images';

// Big faded text on a panel: "Fernando Guzman" -> "FG". A [Name] placeholder shows the role instead.
const panelText = (name: string, role: string) =>
  isPlaceholder(name) ? role : name.split(/\s+/).map((part) => part[0]).join('').slice(0, 3).toUpperCase();

const pad = (n: number) => String(n).padStart(2, '0');

// The lead goes on top on their own; the rest of the team follows in the collage
const lead = team.find((member) => member.lead);
const rest = team.filter((member) => member !== lead);
const firstNumber = lead ? 2 : 1; // the lead is 01, the collage carries on from 02
const leadHasPhoto = lead ? imageExists(`team/${lead.photo}`) : false;

// How each collage card looks, in order. With more people the pattern starts again.
//   ratio:  the photo's shape (width / height)
//   accent: what sits behind the photo: a solid colour block or a thin offset frame
//   drift:  how far it drifts as you scroll (different speeds make the collage move; see BaseLayout.astro)
const looks = [
  { ratio: '3 / 4', accent: 'block-violet', drift: 60 },
  { ratio: '1 / 1', accent: 'frame-orange', drift: 120 },
  { ratio: '4 / 5', accent: 'block-magenta', drift: 80 },
  { ratio: '4 / 3', accent: 'frame-violet', drift: 100 },
  { ratio: '3 / 4', accent: 'block-orange', drift: 70 },
  { ratio: '1 / 1', accent: 'frame-magenta', drift: 110 },
];
const lookFor = (i: number) => looks[i % looks.length];

// Two rows of three. The strip of disciplines and the team statement go between them
// (or after the first row, if there are only three people).
const rows = [rest.slice(0, 3), rest.slice(3)];

// The disciplines for the strip, from the roles: 'Lead Mechanical Engineer' -> 'Mechanical'
const disciplines = [
  ...new Set(
    rest
      .map((member) => member.role.replace(/\b(lead|senior|engineer|engineering)\b/gi, '').trim())
      .filter((word) => word && !isPlaceholder(word)),
  ),
];

// "**one vehicle**" -> a word in a coloured box
const statementParts = teamStatement.headline.split(/\*\*(.+?)\*\*/);

// The team in numbers, for the story band between the lead and the rest of the team.
// The count comes from src/data/team.ts; the two universities and Turtle are from the page intro and Home.
const stats = [
  { title: String(team.length).padStart(2, '0'), text: 'Students on the team' },
  { title: '02', text: 'Universities: Texas A&M and UT Austin' },
  { title: '01', text: 'Vehicle in the build: Turtle' },
];
---

<BaseLayout title="Who we are" description={teamIntro} headerOverlay>
  <PageHeader title="Who we are" href="/who-we-are" intro={teamIntro} caption="Students · College Station, Texas" image="who-we-are.jpg" imagePosition="45% 50%" />

  <!-- Light band: the team collage -->
  <div class="band band--top theme-light">
    <section class="container team">
      <!-- The lead, on a row of their own -->
      {lead && (
        <article class="lead">
          <div class="lead-media" data-drift="40">
            <span class="member-accent member-accent--block-lime" aria-hidden="true"></span>
            {leadHasPhoto ? (
              <Photo file={`team/${lead.photo}`} label={lead.name} ratio="4 / 5" />
            ) : (
              <div class="member-panel" style="aspect-ratio: 4 / 5;" aria-hidden="true">
                <span class="member-initials">{panelText(lead.name, lead.role)}</span>
              </div>
            )}
            <p class="label member-tag"><span class="member-tag-num">01 · </span>{lead.role}</p>
            <!-- Name in violet boxes over the photo's corner, one box per word -->
            <h2 class="lead-name">
              {lead.name.split(/\s+/).map((word) => <span>{word}</span>)}
            </h2>
          </div>

          <!-- Description box -->
          <div class="lead-box" data-drift="100">
            <p class="label lead-role"><span aria-hidden="true">+</span> {lead.role}</p>
            {lead.bio && <p class="lead-bio">{lead.bio}</p>}
            <div class="lead-foot">
              <p class="lead-major">{lead.majorYear}</p>
              {lead.linkedin && (
                <a class="lead-linkedin label" href={lead.linkedin} target="_blank" rel="noopener noreferrer">
                  LinkedIn <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      )}
    </section>
  </div>

  <!-- Story band: the team in numbers, over sun rays under the surface (Pexels) shifted from orange
       to violet, like the "5.5 million square miles" stats on Colossal's mammoth page.
       Copy: the Home "Who we are" card (Content doc). -->
  <StoryBand variant="stats" image="story-team.jpg" position="55% 40%" tag="Students · College Station, Texas" title="A Texas-based student team" items={stats} />

  <!-- Light band: everyone else, in two rows of three with the disciplines strip and the team
       statement between them, so the people get room to breathe -->
  <div class="band band--top theme-light">
    {rows.map((row, r) => (
      <Fragment>
        {r === 1 && disciplines.length > 0 && <Marquee words={disciplines} />}
        <section class:list={['container', 'team', r === 0 ? 'team--before' : 'team--after']}>
          {r === 0 && <SectionHeader number={1} title="The crew" />}

          <!-- A few lines about the team as a whole (teamStatement in src/data/team.ts) -->
          {r === 1 && (
            <div class="ethos">
              <div class="ethos-head" data-reveal>
                <p class="label ethos-tag">[ {teamStatement.tag} ]</p>
                <span class="ethos-hatch" aria-hidden="true"></span>
              </div>
              <p class="ethos-line" data-reveal>
                {statementParts.map((part, i) => (i % 2 === 1 ? <span class:list={['ethos-box', { 'ethos-box--lime': i === statementParts.length - 2 }]}>{part}</span> : part))}
              </p>
              <!-- drifts a little slower than the page (data-drift), on a wrapper so it doesn't fight the fade-in -->
              <div class="ethos-body" data-drift="40">
                <div data-reveal>
                  <p class="ethos-text">{teamStatement.text}</p>
                  <p class="label ethos-sign">[ {teamStatement.signoff} ]</p>
                </div>
              </div>
            </div>
          )}

          {row.length > 0 && (
            <ul class:list={['crew', { 'crew--b': r === 1 }]} data-reveal-group>
              {row.map((member, j) => {
                const i = r * 3 + j; // position in the whole crew, for the number and the look
                const hasPhoto = imageExists(`team/${member.photo}`);
                const look = lookFor(i);
                return (
                  <li class="member">
                    <div class="member-card" data-drift={look.drift}>
                      <div class="member-media">
                        <span class:list={['member-accent', `member-accent--${look.accent}`]} aria-hidden="true"></span>
                        {hasPhoto ? (
                          <Photo file={`team/${member.photo}`} label={member.name} ratio={look.ratio} />
                        ) : (
                          <div class="member-panel" style={`aspect-ratio: ${look.ratio};`} aria-hidden="true">
                            <span class:list={['member-initials', { 'member-initials--role': isPlaceholder(member.name) }]}>{panelText(member.name, member.role)}</span>
                          </div>
                        )}
                        <!-- Orange tag on the photo's corner, like Colossal's role tags -->
                        <p class="label member-tag"><span class="member-tag-num">{pad(i + firstNumber)} · </span>{member.role}</p>
                      </div>
                      <h2 class="member-name">{member.name}</h2>
                      <p class="member-major">{member.majorYear}</p>
                      {member.linkedin && (
                        <a class="member-linkedin label" href={member.linkedin} target="_blank" rel="noopener noreferrer">
                          LinkedIn <span aria-hidden="true">↗</span>
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      </Fragment>
    ))}
  </div>

  <!-- One photo with an offset frame across the edge into the photo below (natural NOAA footage) -->
  <Patch variant="frame" image="feather-star-wide.jpg" caption="Feather star · NOAA" side="right" straddle />

  <!-- One big photo (ocean sunfish, false colour) leading on to Positions. Copy: Content doc, "Open positions" card. -->
  <PhotoBand image="who-we-are.jpg" position="45% 40%" heading="We're recruiting." tag="Open positions">
    <a class="button" href={url('/positions')}>See what roles are open <span aria-hidden="true">→</span></a>
  </PhotoBand>
</BaseLayout>

<style>
  /* ---------- The collage ---------- */

  .team {
    position: relative;
  }

  /* Three columns of different widths. Cards fill them left to right, row by row (so screen readers
     still read the team in order); the middle and right columns are pushed down by different amounts,
     so no two cards line up. */
  .crew {
    --step-2: clamp(4rem, 8vw, 8rem);    /* how far the middle column sits lower */
    --step-3: clamp(1.5rem, 3vw, 3rem);  /* how far the right column sits lower */
    display: grid;
    grid-template-columns: minmax(0, 4.4fr) minmax(0, 3.6fr) minmax(0, 4fr);
    align-items: start;
    gap: clamp(5rem, 8vw, 8rem) clamp(2rem, 4vw, 4.5rem);
    margin: 0;
    padding: var(--space-md) 0 var(--step-2);
    list-style: none;
  }

  /* "translate" (not "transform"), so it adds to the fade-in animation instead of being replaced by it */
  .member:nth-child(3n + 2) {
    translate: 0 var(--step-2);
  }

  .member:nth-child(3n) {
    translate: 0 var(--step-3);
  }

  /* The second row mirrors the first: the wide column on the right, and the heights swapped round */
  .crew--b {
    grid-template-columns: minmax(0, 4fr) minmax(0, 3.6fr) minmax(0, 4.4fr);
  }

  .crew--b .member:nth-child(3n + 1) {
    translate: 0 var(--step-3);
  }

  .crew--b .member:nth-child(3n + 2) {
    translate: none;
  }

  .crew--b .member:nth-child(3n) {
    translate: 0 var(--step-2);
  }

  /* its first card is narrower and sits to the right of its column */
  .crew--b .member:nth-child(1) .member-card {
    width: 82%;
    margin-left: auto;
  }

  /* room between the first row and the disciplines strip, and between the strip and the statement */
  .team--before {
    padding-bottom: var(--space-xl);
  }

  .team--after {
    padding-top: var(--space-2xl);
  }

  /* ---------- What we share: a few lines about the whole team ---------- */

  .ethos {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .ethos-head {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .ethos-tag {
    margin: 0;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-text);
    color: var(--color-text);
  }

  .ethos-hatch {
    flex: 0 0 8rem;
    height: 0.9rem;
    background: repeating-linear-gradient(115deg, var(--color-muted) 0 1px, transparent 1px 7px);
  }

  /* one big sentence in thin, wide capitals, with two phrases in colour boxes */
  .ethos-line {
    grid-column: 1 / span 11;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(2rem, 0.8rem + 3.8vw, 5.2rem);
    line-height: 1.06;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .ethos-box {
    padding: 0 0.16em;
    color: var(--color-white);
    background: var(--color-violet);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .ethos-box--lime {
    color: var(--light-text);
    background: var(--color-lime);
  }

  /* on wider screens a boxed phrase stays on one line (on phones it may wrap, box and all) */
  @media (min-width: 761px) {
    .ethos-box {
      white-space: nowrap;
    }
  }

  /* the paragraph sits to the right, under a hairline with an orange dot on its end */
  .ethos-body {
    position: relative;
    grid-column: 7 / -1;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-text);
  }

  .ethos-body::before {
    content: '';
    position: absolute;
    top: -0.4rem;
    left: 0;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--color-orange);
  }

  .ethos-text {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .ethos-sign {
    margin: var(--space-md) 0 0;
    color: var(--color-accent);
  }

  .member-card {
    position: relative;
  }

  /* ---------- The lead: big portrait on the left, description box on the right ---------- */

  .lead {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
    gap: clamp(3rem, 7vw, 7rem);
    padding: var(--space-xl) 0 clamp(6rem, 10vw, 9rem);
    border-top: 1px solid var(--color-line);
  }

  .lead-media {
    position: relative;
  }

  /* Name in stacked violet boxes hanging over the photo's bottom right corner (Colossal's chairman) */
  .lead-name {
    position: absolute;
    z-index: 3;
    right: calc(-1 * clamp(1rem, 3vw, 3rem));
    bottom: clamp(1.5rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    margin: 0;
    font-size: clamp(2rem, 1rem + 3vw, 4rem);
    line-height: 1;
  }

  .lead-name span {
    padding: 0.08em 0.22em 0.04em;
    color: var(--color-white);
    background: var(--color-violet);
  }

  /* The description box: dark, so it stands out on the light band */
  .lead-box {
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 38rem;
    padding: clamp(1.75rem, 3vw, 3rem);
    color: var(--light-bg);
    background: var(--light-text);
  }

  /* lime square on the box's corner, like the dots on Colossal's photos */
  .lead-box::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: -0.5rem;
    width: 1rem;
    height: 1rem;
    background: var(--color-lime);
  }

  .lead-role {
    margin: 0;
    color: var(--light-bg);
  }

  .lead-role span {
    margin-right: 0.4rem;
    color: var(--color-lime);
  }

  .lead-bio {
    margin: var(--space-md) 0 0;
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.45;
  }

  /* major and year (and LinkedIn) along the bottom, under a hairline */
  .lead-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid color-mix(in srgb, var(--light-bg) 25%, transparent);
  }

  .lead-major {
    margin: 0;
    color: color-mix(in srgb, var(--light-bg) 65%, transparent);
  }

  .lead-linkedin {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ---------- Photo, colour accents and tag ---------- */

  .member-media {
    position: relative;
  }

  .member-media > :global(.photo),
  .member-panel {
    position: relative;
    z-index: 1;
  }

  .member-accent {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .member-accent--block-lime {
    left: -1.25rem;
    bottom: -1.25rem;
    width: 58%;
    height: 46%;
    background: var(--color-lime);
  }

  .member-accent--block-violet {
    right: -1.25rem;
    top: -1.25rem;
    width: 46%;
    height: 58%;
    background: var(--color-violet);
  }

  .member-accent--block-magenta {
    left: -1rem;
    top: -1rem;
    width: 40%;
    height: 50%;
    background: var(--color-magenta);
  }

  /* thin frames offset from the photo, like the outlined photos in Colossal's culture collage */
  .member-accent--frame-orange {
    inset: -0.9rem 0.9rem 0.9rem -0.9rem;
    border: 1px solid var(--color-orange);
  }

  .member-accent--frame-violet {
    inset: 0.9rem -0.9rem -0.9rem 0.9rem;
    border: 1px solid var(--color-violet);
  }

  .member-accent--block-orange {
    right: -1.25rem;
    bottom: -1.25rem;
    width: 50%;
    height: 44%;
    background: var(--color-orange);
  }

  .member-accent--frame-magenta {
    inset: 0.9rem 0.9rem -0.9rem -0.9rem;
    border: 1px solid var(--color-magenta);
  }

  .member-tag {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    left: 0.75rem;
    margin: 0;
    padding: 0.3rem 0.55rem;
    color: var(--color-accent-ink);
    background: var(--color-orange);
  }

  /* Stand-in for a portrait: the right shape, with the person's initials */
  .member-panel {
    display: flex;
    align-items: flex-end;
    padding: var(--space-md);
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--color-surface), color-mix(in srgb, var(--color-surface) 70%, var(--color-bg)));
  }

  .member-initials {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 900;
    font-size: clamp(3rem, 1rem + 5vw, 6rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--color-text) 25%, transparent);
  }

  /* Role text is longer than initials, so it's smaller and wraps */
  .member-initials--role {
    font-size: clamp(1.4rem, 0.8rem + 1.6vw, 2.4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  /* ---------- Name and details ---------- */

  .member-name {
    margin-top: calc(var(--space-md) + 0.5rem);
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.25rem);
  }

  .member-major {
    margin: var(--space-xs) 0 0;
    color: var(--color-muted);
  }

  .member-linkedin {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
  }

  .member-linkedin:hover {
    color: var(--color-accent);
  }

  /* ---------- Tablet and phone: the lead stacks, the collage becomes two staggered columns ---------- */

  @media (max-width: 900px) {
    .ethos-line,
    .ethos-body {
      grid-column: 1 / -1;
    }

    .ethos-body {
      margin-left: clamp(0rem, 12vw, 6rem);
    }

    .lead {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: var(--space-2xl);
    }

    .lead-media {
      width: min(30rem, 84%);
    }

    /* the box tucks up under the photo, a little to the right */
    .lead-box {
      margin: calc(-1 * var(--space-md)) 0 0 auto;
      width: min(34rem, 88%);
    }

    /* the name sits higher, clear of the box */
    .lead-name {
      bottom: calc(var(--space-md) + 1.5rem);
    }

    /* and so do the initials on the placeholder panel, clear of the box and its lime square */
    .lead .member-panel {
      padding-bottom: calc(var(--space-md) + 1.5rem);
    }
  }

  @media (max-width: 1099px) {
    .crew {
      --step-2: clamp(3rem, 10vw, 6rem);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-lg);
    }

    /* every second card sits lower */
    .member:nth-child(3n + 2),
    .member:nth-child(3n) {
      translate: none;
    }

    .member:nth-child(2n) {
      translate: 0 var(--step-2);
    }

    /* the second row: its lone third card moves to the right column, so the two rows zigzag */
    .crew--b {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .crew--b .member:nth-child(n) {
      translate: none;
    }

    .crew--b .member:nth-child(2n) {
      translate: 0 var(--step-2);
    }

    .crew--b .member:nth-child(3) {
      grid-column: 2;
      translate: 0 var(--step-2);
    }

    .crew--b .member:nth-child(1) .member-card {
      width: 100%;
    }
  }

  @media (max-width: 760px) {
    .lead-name {
      right: -0.75rem;
      font-size: 1.75rem;
    }

    .lead-bio {
      font-size: var(--text-base);
    }

    .crew {
      gap: var(--space-xl) var(--space-md);
    }

    .member-accent--block-lime,
    .member-accent--block-magenta {
      left: -0.6rem;
    }

    .member-accent--block-lime {
      bottom: -0.6rem;
    }

    .member-accent--block-violet {
      right: -0.6rem;
      top: -0.6rem;
    }

    .member-accent--block-magenta {
      top: -0.6rem;
    }

    .member-accent--frame-orange {
      inset: -0.5rem 0.5rem 0.5rem -0.5rem;
    }

    .member-accent--frame-violet {
      inset: 0.5rem -0.5rem -0.5rem 0.5rem;
    }

    .member-accent--block-orange {
      right: -0.6rem;
      bottom: -0.6rem;
    }

    .member-accent--frame-magenta {
      inset: 0.5rem 0.5rem -0.5rem -0.5rem;
    }

    .ethos {
      gap: var(--space-md);
    }

    .ethos-line {
      font-stretch: 112%;
      font-size: clamp(1.7rem, 0.9rem + 4.4vw, 2.4rem);
    }

    .ethos-body {
      margin-left: 0;
    }

    .ethos-text {
      font-size: var(--text-base);
    }

    .ethos-hatch {
      flex-basis: 4rem;
    }

