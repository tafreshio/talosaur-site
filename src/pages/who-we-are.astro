---
// Who we are: team cards. Team members are listed in src/data/team.ts.
// A member with a photo in public/images/team/ gets a photo card; without one, a solid panel with initials.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Patch from '../components/Patch.astro';
import { url } from '../lib/url';
import Photo from '../components/Photo.astro';
import { team, teamIntro } from '../data/team';
import { isPlaceholder } from '../data/site';
import { imageExists, imageUrl } from '../lib/images';

// Big faded text on a panel: "Fernando Guzman" -> "FG". A [Name] placeholder shows the role instead.
const panelText = (name: string, role: string) =>
  isPlaceholder(name) ? role : name.split(/\s+/).map((part) => part[0]).join('').slice(0, 3).toUpperCase();
---

<BaseLayout title="Who we are" description={teamIntro} headerOverlay>
  <PageHeader title="Who we are" href="/who-we-are" intro={teamIntro} caption="Students · College Station, Texas" image="who-we-are.jpg" imagePosition="45% 50%" />

  <!-- Light band: everything below the photo header -->
  <div class="band band--top theme-light">
    <section class="container">
      <ul class="team-grid" data-reveal-group>
        {team.map((member, i) => {
          const hasPhoto = imageExists(`team/${member.photo}`);
          return (
            <li class="member">
              {hasPhoto ? (
                <Photo file={`team/${member.photo}`} label={member.name} ratio="4 / 5" />
              ) : (
                <div class="member-panel" aria-hidden="true">
                  <span class="label member-index">{String(i + 1).padStart(2, '0')}</span>
                  <span class:list={['member-initials', { 'member-initials--role': isPlaceholder(member.name) }]}>{panelText(member.name, member.role)}</span>
                </div>
              )}
              <h2 class="member-name">{member.name}</h2>
              <p class="member-role">{member.role}</p>
              <p class="member-major">{member.majorYear}</p>
              {member.linkedin && (
                <a class="member-linkedin label" href={member.linkedin} target="_blank" rel="noopener noreferrer">
                  LinkedIn <span aria-hidden="true">↗</span>
                </a>
              )}
            </li>
          );
        })}
        <!-- Sixth tile: open positions (Content doc copy). Behind the words: a 1900 engraving of a fish
             skeleton in Colossal's orange-to-violet gradient (their Careers page has a gradient skull).
             Picture: public/images/accents/skeleton-tile.jpg -->
        <li class="member">
          <a class="member-join" href={url('/positions')}>
            <img class="member-join-art" src={imageUrl('accents/skeleton-tile.jpg')} alt="" width="1000" height="1250" loading="lazy" decoding="async" />
            <span class="label member-index">{String(team.length + 1).padStart(2, '0')}</span>
            <span class="member-join-title">Open positions <span aria-hidden="true">→</span></span>
          </a>
          <p class="member-join-text" style="margin-top: var(--space-sm);">We're recruiting. See what roles are open.</p>
        </li>
      </ul>
    </section>
  </div>

  <!-- Inset photo sitting across the edge between the team and the photo below -->
  <Patch variant="contact" images={['frame-descent.jpg', 'frame-wall.jpg', 'frame-feather-star.jpg']} captions={['Descent', 'Canyon wall', 'Feather star']} side="right" straddle />

  <!-- One big photo (ocean sunfish, false colour) leading on to Positions. Copy: Content doc, "Open positions" card. -->
  <PhotoBand image="who-we-are.jpg" position="45% 40%" heading="We're recruiting." tag="Open positions">
    <a class="button" href={url('/positions')}>See what roles are open <span aria-hidden="true">→</span></a>
  </PhotoBand>
</BaseLayout>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-md);
    margin: 0;
    padding: var(--space-lg) 0 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .member {
    display: flex;
    flex-direction: column;
  }

  /* Stand-in for a portrait: same shape as a photo, with the person's initials */
  .member-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 4 / 5;
    padding: var(--space-md);
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--color-surface), color-mix(in srgb, var(--color-surface) 70%, var(--color-bg)));
  }

  .member-index {
    color: var(--color-accent);
  }

  .member-initials {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 900;
    font-size: clamp(3rem, 1rem + 5vw, 6rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--color-text) 25%, transparent);
  }

  /* Role text is longer than initials, so it's smaller and wraps */
  .member-initials--role {
    font-size: clamp(1.6rem, 0.8rem + 2vw, 2.6rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  /* Name sits under a thin line, like the captions on the Home cards */
  .member-name {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2rem);
  }

  .member-role {
    margin: var(--space-xs) 0 0;
    font-weight: 600;
    color: var(--color-accent);
  }

  .member-major {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
  }

  .member-linkedin {
    align-self: flex-start;
    margin-top: var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
  }

  .member-linkedin:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1023px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The last tile: an invitation to join, linking to Positions (Content doc "Open positions" card) */
  .member-join {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 4 / 5;
    padding: var(--space-md);
    overflow: hidden;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-white);
    background: var(--color-violet);
  }

  /* The edited engraving fills the tile; the words sit on top of it */
  .member-join-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .member-join > :not(.member-join-art) {
    position: relative;
  }

  .member-join .member-index {
    color: var(--color-white);
  }

  .member-join:hover .member-join-art {
    transform: scale(1.04);
  }

  .member-join-title {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: clamp(1.6rem, 0.8rem + 2vw, 2.6rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .member-join-title span {
    display: inline-block;
    transition: transform var(--duration) var(--ease);
  }

  .member-join:hover .member-join-title span {
    transform: translateX(6px);
  }

  .member-join-text {
    margin: 0;
    color: var(--color-muted);
  }

  /* Phone: keep two across so each card doesn't fill the whole screen */
  @media (max-width: 480px) {
    .team-grid {
      gap: var(--space-lg) var(--space-sm);
    }

    .member-name {
      font-size: 1.25rem;
    }

    .member-role,
    .member-major {
      font-size: var(--text-sm);
    }
  }
</style>
