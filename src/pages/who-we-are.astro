---
// Who we are: the team, in the style of the people sections on Colossal's Company page.
//   - The lead (lead: true in src/data/team.ts) gets a row of their own: a big portrait with their name
//     in violet boxes over its corner, and a description box beside it (like Colossal's chairman feature).
//   - Everyone else is a staggered collage below: cards of different sizes, columns at different
//     heights, colour blocks and frames offset behind the photos, and each card drifting at its own
//     speed as you scroll.
//   - The collage is split in two rows of three. Between them: a slow strip of the team's disciplines
//     (taken from the roles) and a few lines about the team as a whole (teamStatement in team.ts).
//
// Team members are listed in src/data/team.ts. A member with a photo in public/images/team/ gets a
// photo card; without one, a plain panel with their initials. People's photos stay natural (no colour
// edits): the colour is only in the blocks behind them.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Patch from '../components/Patch.astro';
import StoryBand from '../components/StoryBand.astro';
import { url } from '../lib/url';
import Photo from '../components/Photo.astro';
import Marquee from '../components/Marquee.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Statement from '../components/Statement.astro';
import { team, teamIntro, teamStatement } from '../data/team';
import { isPlaceholder } from '../data/site';
import { imageExists } from '../lib/images';

// Big faded text on a panel: "Fernando Guzman" -> "FG". A [Name] placeholder shows the role instead.
const panelText = (name: string, role: string) =>
  isPlaceholder(name) ? role : name.split(/\s+/).map((part) => part[0]).join('').slice(0, 3).toUpperCase();

const pad = (n: number) => String(n).padStart(2, '0');

// The lead goes on top on their own; the rest of the team follows in the collage
const lead = team.find((member) => member.lead);
const rest = team.filter((member) => member !== lead);
const firstNumber = lead ? 2 : 1; // the lead is 01, the collage carries on from 02
const leadHasPhoto = lead ? imageExists(`team/${lead.photo}`) : false;

// How each crew card looks, in order. Every portrait is the same shape (4:5); only the colour block
// behind it changes: its colour, and whether it sits off the top right or the bottom left corner.
// drift: how far it drifts as you scroll (see BaseLayout.astro); the middle column moves a little more.
const RATIO = '4 / 5';
const looks = [
  { accent: 'tr', color: 'violet', drift: 50 },
  { accent: 'bl', color: 'orange', drift: 80 },
  { accent: 'tr', color: 'magenta', drift: 50 },
  { accent: 'bl', color: 'violet', drift: 50 },
  { accent: 'tr', color: 'orange', drift: 80 },
  { accent: 'bl', color: 'magenta', drift: 50 },
];
const lookFor = (i: number) => looks[i % looks.length];

// Two rows of three. The strip of disciplines and the team statement go between them
// (or after the first row, if there are only three people).
const rows = [rest.slice(0, 3), rest.slice(3)];

// The disciplines for the strip, from the roles: 'Lead Mechanical Engineer' -> 'Mechanical'
const disciplines = [
  ...new Set(
    rest
      .map((member) => member.role.replace(/\b(lead|senior|engineer|engineering)\b/gi, '').trim())
      .filter((word) => word && !isPlaceholder(word)),
  ),
];

// The team in numbers, for the story band between the lead and the rest of the team.
// The count comes from src/data/team.ts; the two universities and Turtle are from the page intro and Home.
const stats = [
  { title: String(team.length).padStart(2, '0'), text: 'Students on the team' },
  { title: '02', text: 'Universities: Texas A&M and UT Austin' },
  { title: '01', text: 'Vehicle in the build: Turtle' },
];
---

<BaseLayout title="Who we are" description={teamIntro} headerOverlay>
  <PageHeader title="Who we are" href="/who-we-are" intro={teamIntro} caption="Students · College Station, Texas" image="who-we-are.jpg" imagePosition="45% 50%" />

  <!-- Light band: the team collage -->
  <div class="band band--top theme-light">
    <section class="container team">
      <!-- The lead, on a row of their own -->
      {lead && (
        <article class="lead">
          <div class="lead-media" data-drift="40">
            <span class="member-accent member-accent--block-lime" aria-hidden="true"></span>
            {leadHasPhoto ? (
              <Photo file={`team/${lead.photo}`} label={lead.name} ratio="4 / 5" />
            ) : (
              <div class="member-panel" style="aspect-ratio: 4 / 5;" aria-hidden="true">
                <span class="label member-soon">[ Photo to come ]</span>
                <span class="member-initials">{panelText(lead.name, lead.role)}</span>
              </div>
            )}
            <p class="label member-tag"><span class="member-tag-num">01 · </span>{lead.role}</p>
            <!-- Name in violet boxes over the photo's corner, one box per word -->
            <h2 class="lead-name">
              {lead.name.split(/\s+/).map((word) => <span>{word}</span>)}
            </h2>
          </div>

          <!-- Description box -->
          <div class="lead-box" data-drift="100">
            <p class="label lead-role"><span aria-hidden="true">+</span> {lead.role}</p>
            {lead.bio && <p class="lead-bio">{lead.bio}</p>}
            <div class="lead-foot">
              <p class="lead-major">{lead.majorYear}</p>
              {lead.linkedin && (
                <a class="lead-linkedin label" href={lead.linkedin} target="_blank" rel="noopener noreferrer">
                  LinkedIn <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      )}
    </section>
  </div>

  <!-- Story band: the team in numbers, over sun rays under the surface (Pexels) shifted from orange
       to violet, like the "5.5 million square miles" stats on Colossal's mammoth page.
       Copy: the Home "Who we are" card (Content doc). -->
  <StoryBand variant="stats" image="story-team.jpg" position="55% 40%" tag="The team in numbers" title="A Texas-based student team" items={stats} />

  <!-- Light band: everyone else, in two rows of three with the disciplines strip and the team
       statement between them, so the people get room to breathe -->
  <div class="band band--top theme-light">
    {rows.map((row, r) => (
      <Fragment>
        {r === 1 && disciplines.length > 0 && <Marquee words={disciplines} />}
        <section class:list={['container', 'team', r === 0 ? 'team--before' : 'team--after']}>
          {r === 0 && <SectionHeader number={1} title="The crew" />}

          <!-- A few lines about the team as a whole (teamStatement in src/data/team.ts) -->
          {r === 1 && (
            <div class="ethos">
              <Statement tag={teamStatement.tag} headline={teamStatement.headline} text={teamStatement.text} signoff={teamStatement.signoff} />
            </div>
          )}

          {row.length > 0 && (
            <ul class="crew" data-reveal-group>
              {row.map((member, j) => {
                const i = r * 3 + j; // position in the whole crew, for the number and the look
                const hasPhoto = imageExists(`team/${member.photo}`);
                const look = lookFor(i);
                return (
                  <li class="member">
                    <div class="member-card" data-drift={look.drift}>
                      <div class="member-media">
                        <span class:list={['member-accent', `member-accent--${look.accent}`]} style={`--accent: var(--color-${look.color});`} aria-hidden="true"></span>
                        {hasPhoto ? (
                          <Photo file={`team/${member.photo}`} label={member.name} ratio={RATIO} />
                        ) : (
                          <div class="member-panel" style={`aspect-ratio: ${RATIO};`} aria-hidden="true">
                            <span class="label member-soon">[ Photo to come ]</span>
                            <span class:list={['member-initials', { 'member-initials--role': isPlaceholder(member.name) }]}>{panelText(member.name, member.role)}</span>
                          </div>
                        )}
                        <!-- Orange tag on the photo's corner, like Colossal's role tags -->
                        <p class="label member-tag"><span class="member-tag-num">{pad(i + firstNumber)} · </span>{member.role}</p>
                      </div>
                      <h2 class="member-name">{member.name}</h2>
                      <p class="member-major">{member.majorYear}</p>
                      {member.linkedin && (
                        <a class="member-linkedin label" href={member.linkedin} target="_blank" rel="noopener noreferrer">
                          LinkedIn <span aria-hidden="true">↗</span>
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      </Fragment>
    ))}
  </div>

  <!-- One photo with an offset frame across the edge into the photo below (natural NOAA footage) -->
  <Patch variant="frame" image="feather-star-wide.jpg" caption="Feather star · NOAA" side="right" straddle />

  <!-- One big photo (ocean sunfish, false colour) leading on to Positions. Copy: Content doc, "Open positions" card. -->
  <PhotoBand image="who-we-are.jpg" position="45% 40%" heading="We're recruiting." tag="Open positions">
    <a class="button" href={url('/positions')}>See what roles are open <span aria-hidden="true">→</span></a>
  </PhotoBand>
</BaseLayout>

<style>
  /* ---------- The collage ---------- */

  .team {
    position: relative;
  }

  /* Three equal columns, the middle one a step lower, the same in both rows. Cards fill them left to
     right, row by row (so screen readers still read the team in order). */
  .crew {
    --step: clamp(3rem, 6vw, 5.5rem);   /* how far the middle column sits lower */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(4rem, 7vw, 7rem) clamp(2rem, 4vw, 4rem);
    margin: 0;
    padding: var(--space-md) 1.25rem var(--step);   /* the side padding leaves room for the colour blocks */
    list-style: none;
  }

  /* "translate" (not "transform"), so it adds to the fade-in animation instead of being replaced by it */
  .member:nth-child(3n + 2) {
    translate: 0 var(--step);
  }

  /* room between the first row and the disciplines strip, and between the strip and the statement */
  .team--before {
    padding-bottom: var(--space-xl);
  }

  .team--after {
    padding-top: var(--space-2xl);
  }

  /* ---------- What we share (src/components/Statement.astro) ---------- */

  .ethos {
    margin-bottom: var(--space-2xl);
  }

  /* ---------- The lead: big portrait on the left, description box on the right ---------- */

  .lead {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
    gap: clamp(3rem, 7vw, 7rem);
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid var(--color-line);
  }

  .lead-media {
    position: relative;
  }

  /* Name in stacked violet boxes hanging over the photo's bottom right corner (Colossal's chairman) */
  .lead-name {
    position: absolute;
    z-index: 3;
    right: calc(-1 * clamp(1rem, 3vw, 3rem));
    bottom: clamp(1.5rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    margin: 0;
    font-size: clamp(2rem, 1rem + 3vw, 4rem);
    line-height: 1;
  }

  .lead-name span {
    padding: 0.08em 0.22em 0.04em;
    color: var(--color-white);
    background: var(--color-violet);
  }

  /* The description box: dark, so it stands out on the light band */
  .lead-box {
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 38rem;
    padding: clamp(1.75rem, 3vw, 3rem);
    color: var(--light-bg);
    background: var(--light-text);
  }

  /* lime square on the box's corner, like the dots on Colossal's photos */
  .lead-box::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: -0.5rem;
    width: 1rem;
    height: 1rem;
    background: var(--color-lime);
  }

  .lead-role {
    margin: 0;
    color: var(--light-bg);
  }

  .lead-role span {
    margin-right: 0.4rem;
    color: var(--color-lime);
  }

  .lead-bio {
    margin: var(--space-md) 0 0;
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.45;
  }

  /* major and year (and LinkedIn) along the bottom, under a hairline */
  .lead-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid color-mix(in srgb, var(--light-bg) 25%, transparent);
  }

  .lead-major {
    margin: 0;
    color: color-mix(in srgb, var(--light-bg) 65%, transparent);
  }

  .lead-linkedin {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ---------- Photo, colour accents and tag ---------- */

  .member-media {
    position: relative;
  }

  .member-media > :global(.photo),
  .member-panel {
    position: relative;
    z-index: 1;
  }

  .member-accent {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  /* the founder's lime block, off the bottom left corner */
  .member-accent--block-lime {
    left: -1.25rem;
    bottom: -1.25rem;
    width: 58%;
    height: 46%;
    background: var(--color-lime);
  }

  /* the crew's blocks: one shape, off the top right or the bottom left corner, in the card's colour */
  .member-accent--tr,
  .member-accent--bl {
    width: 48%;
    height: 46%;
    background: var(--accent, var(--color-violet));
  }

  .member-accent--tr {
    top: -1.25rem;
    right: -1.25rem;
  }

  .member-accent--bl {
    bottom: -1.25rem;
    left: -1.25rem;
  }

  .member-tag {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    left: 0.75rem;
    margin: 0;
    padding: 0.3rem 0.55rem;
    color: var(--color-accent-ink);
    background: var(--color-orange);
  }

  /* Stand-in for a portrait until the photo is added: the same dark striped panel as the site's other
     "photo to come" panels, with the person's initials large in the corner */
  .member-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-md);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(135deg, rgb(232 241 245 / 0.06) 0 1px, transparent 1px 14px),
      linear-gradient(160deg, #0c2236, #06121f);
  }

  .member-soon {
    color: var(--color-lime);
  }

  .member-initials {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    word-spacing: 0.1em; /* the condensed face squeezes the spaces too */
    font-weight: 900;
    font-size: clamp(3rem, 1rem + 5vw, 6rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: rgb(232 241 245 / 0.85);
  }

  /* Role text is longer than initials, so it's smaller and wraps */
  .member-initials--role {
    font-size: clamp(1.4rem, 0.8rem + 1.6vw, 2.4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  /* ---------- Name and details ---------- */

  .member-name {
    margin-top: calc(var(--space-md) + 0.5rem);
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.25rem);
  }

  .member-major {
    margin: var(--space-xs) 0 0;
    color: var(--color-muted);
  }

  .member-linkedin {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
  }

  .member-linkedin:hover {
    color: var(--color-accent);
  }

  /* ---------- Tablet and phone: the lead stacks, the collage becomes two staggered columns ---------- */

  @media (max-width: 900px) {
    .lead {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: var(--space-2xl);
    }

    .lead-media {
      width: min(30rem, 84%);
    }

    /* the box tucks up under the photo, a little to the right */
    .lead-box {
      margin: calc(-1 * var(--space-md)) 0 0 auto;
      width: min(34rem, 88%);
    }

    /* the name sits higher, clear of the box */
    .lead-name {
      bottom: calc(var(--space-md) + 1.5rem);
    }

    /* and so do the initials on the placeholder panel, clear of the box and its lime square */
    .lead .member-panel {
      padding-bottom: calc(var(--space-md) + 1.5rem);
    }
  }

  @media (max-width: 1099px) {
    .crew {
      --step: clamp(2.5rem, 9vw, 5rem);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-lg);
    }

    /* every second card sits lower */
    .member:nth-child(3n + 2) {
      translate: none;
    }

    .member:nth-child(2n) {
      translate: 0 var(--step);
    }

    /* each row has three people, so the third goes across both columns as a wider card */
    .member:nth-child(3) {
      grid-column: 1 / -1;
    }

    .member:nth-child(3) .member-panel,
    .member:nth-child(3) .member-media > :global(.photo) {
      aspect-ratio: 16 / 10 !important;
    }
  }

  @media (max-width: 760px) {
    .lead-name {
      right: -0.75rem;
      font-size: 1.75rem;
    }

    .lead-bio {
      font-size: var(--text-base);
    }

    .crew {
      gap: var(--space-xl) var(--space-md);
    }

    .member-accent--block-lime {
      left: -0.6rem;
      bottom: -0.6rem;
    }

    .member-accent--tr {
      top: -0.6rem;
      right: -0.6rem;
    }

    .member-accent--bl {
      bottom: -0.6rem;
      left: -0.6rem;
    }

    /* on phones the tag drops its number; a long role wraps onto two even lines */
    .member-tag {
      top: 0.4rem;
      left: 0.4rem;
      right: 0.4rem;
      width: fit-content;
      padding: 0.2rem 0.4rem;
      font-size: 0.66rem;
    }

    .member-tag-num {
      display: none;
    }

    /* the colour blocks poke out about 0.6rem; this keeps them inside the page margin */
    .crew {
      padding-inline: 0.6rem;
    }

    .lead-media {
      margin-left: 0.6rem;
    }

    .member-panel {
      padding: var(--space-sm);
    }

    .member-name {
      margin-top: var(--space-md);
      font-size: 1.25rem;
    }

    .member-major {
      font-size: var(--text-sm);
    }

  }
</style>
