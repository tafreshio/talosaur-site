---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Plan from '../components/Plan.astro';
import StoryBand from '../components/StoryBand.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Card from '../components/Card.astro';
import Specimen from '../components/Specimen.astro';
import WhyItMatters from '../components/WhyItMatters.astro';
import Partners from '../components/Partners.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { team } from '../data/team';
import { imageUrl, imageExists } from '../lib/images';
import { heroCards, featuredHeading, featuredCards, helpButtons, interestedCards, echoFigures } from '../data/home';
import { explored } from '../data/problem';
import { getSortedNews, formatNewsDate } from '../lib/news';
import { url } from '../lib/url';

// The four newest news entries (newest first)
const latestNews = (await getSortedNews()).slice(0, 4);
const pad = (n: number) => String(n).padStart(2, '0');

// Section 05's collage: a card whose photo is still to come gets a shorter panel, so the collage
// doesn't read as a wall of empty frames. The full shape comes back as soon as the photo is added.
const ratioFor = (card: { photo?: string }, full: string, pending: string) => (card.photo && imageExists(card.photo) ? full : pending);

// Section 05's crew panel: the same three numbers as the Who we are page
const crewStats = [
  { value: pad(team.length), text: 'Students on the team' },
  { value: '02', text: 'Universities: Texas A&M and UT Austin' },
  { value: '01', text: 'Vehicle in the build: Turtle' },
];
---

<BaseLayout headerOverlay>
  <HeroVideo />

  <!-- Light band: Sections 01 and 02 (white after the dark video, like Colossal) -->
  <div class="band theme-light">
    <!-- Section 01: headline and intro -->
    <section id="intro" class="container section intro">
      <SectionHeader number={1} />
      <div class="intro-grid">
        <h1 class="intro-title" data-reveal>Life at <span class="nowrap">50–300&nbsp;m</span> is barely watched.</h1>
        <div class="intro-body" data-reveal>
          <p class="intro-text">
            The ocean's twilight zone is too deep for divers and too costly to visit often.
            Talosaur is a Texas-based student team building a low-cost underwater robot that
            finds, follows and films marine life there.
          </p>
          <a class="button" href={url('/the-problem')}>Read more <span aria-hidden="true">→</span></a>
          <!-- two figures from The Problem (explored in src/data/problem.ts), as still pictures: the dotted
               Earth with the mapped share lit, and how little of the deep seafloor anyone has seen -->
          <div class="intro-figures">
            <img class="intro-globe" src={imageUrl('figures/globe-mapped.svg')} alt="" width="600" height="600" loading="lazy" decoding="async" />
            <div class="intro-stats">
              <p class="intro-stat">
                <span class="intro-fig-value">{explored.mapped.value}</span>
                <span class="intro-fig-text">of the seafloor is mapped in detail.</span>
              </p>
              <p class="intro-stat">
                <span class="intro-fig-value">{explored.seen.value}</span>
                <span class="intro-fig-text">of the deep seafloor has ever been seen.</span>
              </p>
              <a class="label intro-fig-src" href={url('/the-problem')}>See the figures <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- A thin, long picture between Section 01 and 02, like the panoramic "breather" strips between
         text blocks on Colossal's pages: a school of fish (Pexels) in violet with lime highlights
         (public/images/bands/strip-school.jpg, 2400 x 525, made by stills_site/make_strip.py) -->
    <div class="container strip-wrap">
      <figure class="strip" aria-hidden="true" data-drift="40">
        <img src={imageUrl('bands/strip-school.jpg')} alt="" width="2400" height="525" loading="lazy" decoding="async" />
        <span class="strip-corner strip-corner--tl"></span>
        <span class="strip-corner strip-corner--br"></span>
      </figure>
    </div>

    <!-- Section 02: what we're doing. The plan, right after "Life at 50–300 m is barely watched":
         where Turtle and the eDNA work are heading, and what we'll offer (src/components/Plan.astro,
         text in src/data/home.ts). id="plan" so other pages can link straight here (/#plan). -->
    <section class="container section plan" id="plan">
      <SectionHeader number={2} title="What we're doing" />
      <Plan />
    </section>
  </div>

  <!-- Story band: FIND / FOLLOW / FILM (the three verbs of the intro, Content doc) stacked over the
       spiral coral (NOAA) in magenta and green, like the "Lost but not gone forever" band on
       Colossal's mammoth page. Under the words, a boxed number for each (echoFigures in src/data/home.ts). -->
  <StoryBand
    variant="echo"
    image="story-find.jpg"
    tag="The twilight zone"
    items={[
      { title: 'Find', text: 'marine life' },
      { title: 'Follow', text: '50–300 m down' },
      { title: 'Film', text: 'at low cost' },
    ]}
    figures={echoFigures}
  />

  <!-- Light band: Section 03 -->
  <div class="band theme-light">
    <!-- Section 03: three cards -->
    <section class="container section">
      <SectionHeader number={3} title="In the works" />
      <!-- Feature layout: the first card (Turtle) is big and square, the other two stack beside it -->
      <div class="card-grid card-grid--feature" data-reveal-group data-drift="90">
        {heroCards.map((card, i) => (
          <Card {...card} index={i + 1} ratio={i === 0 ? '1 / 1' : '16 / 9'} feature={i === 0} />
        ))}
      </div>
    </section>
  </div>

  <!-- Section 04: why it matters (new). The one dark break in Home's long light stretch: the reef
       panorama with a statement, then a dial and three sourced rows on navy, with a lanternfish photo
       across the edge (src/components/WhyItMatters.astro, text in src/data/home.ts). -->
  <WhyItMatters number={4} />

  <!-- Light band: Section 05 (light, so the page doesn't run dark from here to the news). A radiolarian
       from the 1887 HMS Challenger plates (false colour) runs off the right edge across the join with
       Section 04 above, like Colossal's cut-out animals. -->
  <div class="band theme-light band--specimen">
    <Specimen image="radiolarian.webp" label="Radiolarian · HMS Challenger, 1887" top="clamp(-6rem, -6vw, -3rem)" size="clamp(11rem, 16vw, 15rem)" drift={20} />
    <!-- Section 05: featured content, as a staggered collage (Colossal's asymmetric photo grids): the
         Who we are card big, the crew in numbers beside it, then the other two cards offset below.
         The layout is the .collage rules below. -->
    <section class="container section">
      <SectionHeader number={5} title={featuredHeading} />
      <div class="collage" data-reveal-group>
        <div class="collage-a"><Card {...featuredCards[0]} index={1} ratio={ratioFor(featuredCards[0], '3 / 2', '2 / 1')} feature /></div>
        <aside class="collage-crew crew-panel" aria-label="The crew in numbers">
          <p class="crew-tag"><span class="tag tag--glass">The crew</span></p>
          <ul class="crew-stats">
            {crewStats.map((stat) => (
              <li>
                <span class="readout crew-value">{stat.value}</span>
                <span class="crew-text">{stat.text}</span>
              </li>
            ))}
          </ul>
          <a class="text-link label crew-link" href={url('/who-we-are')}>Meet the crew <span aria-hidden="true">→</span></a>
        </aside>
        <div class="collage-b"><Card {...featuredCards[1]} index={2} ratio={ratioFor(featuredCards[1], '4 / 3', '16 / 10')} /></div>
        <div class="collage-c"><Card {...featuredCards[2]} index={3} ratio={ratioFor(featuredCards[2], '16 / 9', '2 / 1')} /></div>
      </div>
    </section>
  </div>

  <!-- Section 06: one big photo (sand tiger shark, false colour) with the help buttons over it -->
  <PhotoBand image="home.jpg" position="38% 50%" label="Section 06" heading="How can we help?" tag="Researchers · Sanctuaries · Offshore teams" split>
    <ol class="help-list" data-reveal-group>
      {helpButtons.map((button, i) => (
        <li>
          <a class="help-row" href={url(button.href)}>
            <span class="label help-num">{pad(i + 1)}</span>
            <span class="help-label">{button.label}</span>
            <span class="help-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </PhotoBand>


  <!-- Dark band: Section 07 (like Colossal's black "In the news", which has a faint shimmering
       texture behind it). Ours is NOAA sonar data of the seafloor, recoloured and kept dark. -->
  <div class="band band--sonar">
    <img class="band-texture" src={imageUrl('accents/sonar.jpg')} alt="" width="2400" height="1000" loading="lazy" decoding="async" aria-hidden="true" />
    <!-- Section 07: latest news -->
    <section class="container section">
      <SectionHeader number={7} title="Latest news">
        <a class="text-link label" href={url('/news')}>All news <span aria-hidden="true">→</span></a>
      </SectionHeader>
      <ol class="news-grid" data-reveal-group>
        {latestNews.map((entry) => (
          <li class="news-card">
            <p class="label news-meta">
              {entry.data.date
                ? <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatNewsDate(entry)}</time>
                : <span>{formatNewsDate(entry)}</span>}
              <span class="news-kind">News</span>
            </p>
            <h3 class="news-title">
              <a href={url(`/news#${entry.id}`)}>{entry.data.title}</a>
            </h3>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <!-- Light band: Section 08 -->
  <div class="band theme-light">
    <!-- Section 08: You may also be interested in, as a short numbered index (thumbnail, title, line,
         arrow), so the page ends quickly instead of on a third row of big cards -->
    <section class="container section">
      <SectionHeader number={8} title="You may also be interested in" />
      <ol class="more-list" data-reveal-group>
        {interestedCards.map((card, i) => (
          <li>
            <a class="more-row" href={url(card.href)}>
              <span class="more-thumb">
                {imageExists(card.photo)
                  ? <img src={imageUrl(card.photo)} alt="" width="320" height="180" loading="lazy" decoding="async" />
                  : <PhotoPlaceholder label={card.standIn ?? card.title} compact />}
                <span class="more-corner more-corner--tl"></span>
                <span class="more-corner more-corner--br"></span>
              </span>
              <span class="label more-num">{pad(i + 1)}</span>
              <span class="more-title">{card.title}</span>
              <span class="more-text">{card.text}</span>
              <span class="more-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <!-- Section 09: founding partners (new), last before the footer, as on Colossal's Home page (white,
       then the black partners band running into the black footer). Like Colossal's black "Conservation partners" band, with
       open slots until the first partners sign on (src/components/Partners.astro, text in src/data/home.ts). -->
  <Partners number={9} />

</BaseLayout>

<style>
  .section {
    padding-top: var(--space-2xl);
  }

  /* ---------- The thin picture between Section 01 and 02 ---------- */

  .strip-wrap {
    padding-top: var(--space-xl);
  }

  .strip {
    position: relative;
    margin: 0;
    aspect-ratio: 2400 / 525;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* thin white corner brackets, like a viewfinder (Colossal's lab-notebook marks) */
  .strip-corner {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 0 solid rgb(255 255 255 / 0.8);
  }

  .strip-corner--tl {
    top: 0.75rem;
    left: 0.75rem;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .strip-corner--br {
    right: 0.75rem;
    bottom: 0.75rem;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  /* on phones it stays thin, but not so thin the fish disappear */
  @media (max-width: 760px) {
    .strip {
      aspect-ratio: 2.2 / 1;
    }
  }

  /* the fixed header shouldn't cover the section heading when you land on /#plan */
  .plan {
    scroll-margin-top: var(--header-height);
  }


  /* ---------- Section 01 ---------- */

  .intro {
    scroll-margin-top: var(--header-height); /* so the "Scroll" link doesn't hide it under the header */
  }

  /* Headline on the left, text and button on the right, both starting at the top */
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-lg) var(--space-xl);
    align-items: start;
  }

  .intro-title {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1rem + 6.5vw, 7rem);
  }

  .nowrap {
    white-space: nowrap; /* keeps "50–300 m" on one line */
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: 34rem;
    padding-top: 0.6rem; /* lines the first line of text up with the top of the headline */
  }

  .intro-text {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  /* two small figures side by side under the button, filling the space beside the tall headline */
  .intro-figures {
    display: grid;
    gap: var(--space-md);
    width: 100%;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
  }

  /* the Earth on the left, its two numbers beside it at the same size */
  .intro-figures {
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    align-items: center;
  }

  .intro-globe {
    display: block;
    width: 100%;
    height: auto;
  }

  .intro-stats {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md); /* more room between the two figures than inside each */
  }

  .intro-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
  }

  /* big numbers: the readout voice, in the text colour (cyan is only for things you can click) */
  .intro-fig-value {
    font-family: var(--font-display);
    font-stretch: var(--wide-width);
    font-weight: 200;
    font-size: clamp(2.25rem, 1.4rem + 1.6vw, 3rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .intro-fig-text {
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  /* phones: the Earth centred, the two numbers side by side under it */
  @media (max-width: 760px) {
    .intro-figures {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .intro-globe {
      width: min(15rem, 70%);
    }

    .intro-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: var(--space-sm) var(--space-md);
    }

    .intro-fig-src {
      grid-column: 1 / -1;
    }

    .intro-fig-value {
      font-size: 2rem;
    }
  }

  .intro-fig-src {
    display: inline-block;
    padding-block: 0.3rem; /* an easier tap target on phones */
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ---------- Card grids (Section 03) ---------- */

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-md);
  }

  /* Section 03: a wide left column for the big card, a narrower right column for the
     other two. "grid-row: span 2" lets the big card take the height of both rows.
     :global() is needed because the cards come from Card.astro, and Astro's scoped
     styles here would otherwise only match elements written in this file. */
  .card-grid--feature {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: var(--space-lg) var(--space-lg);
  }

  .card-grid--feature > :global(:first-child) {
    grid-row: span 2;
  }

  /* ---------- Section 05: the staggered collage ----------
     Colossal's asymmetric photo grids: nothing lines up with its neighbour. On a 12-column grid,
     the Who we are card takes 7 columns, the crew panel sits in the last 4, a step lower; then the
     positions card (columns 2 to 6) and the build log (7 to 12) are offset again on the next row. */
  .collage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
    align-items: start;
  }

  .collage-a { grid-column: 1 / 8; }
  .collage-crew { grid-column: 9 / 13; margin-top: var(--space-2xl); }
  .collage-b { grid-column: 2 / 6; margin-top: var(--space-lg); }
  .collage-c { grid-column: 7 / 13; margin-top: calc(var(--space-2xl) * 0.9); }

  /* The crew in numbers: a dark inset panel on the light band (the lime corner square marks it) */
  .crew-panel {
    position: relative;
    padding: var(--space-md) var(--space-md) var(--space-sm);
    background: #0b1620;
    color: #e8f1f5;
    --color-line: #1c3a52;
    --color-muted: #8fa8b8;
    --color-accent: #3de0d0;
  }

  .crew-panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    background: var(--color-lime);
  }

  .crew-tag {
    margin: 0 0 var(--space-sm);
  }

  .crew-stats {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crew-stats li {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-sm);
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .crew-value {
    font-size: var(--readout-2);
    line-height: 0.9;
  }

  .crew-text {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .crew-link {
    margin-top: var(--space-xs);
  }

  @media (max-width: 1023px) {
    .collage-a { grid-column: 1 / 13; }
    .collage-crew { grid-column: 1 / 7; margin-top: 0; }
    .collage-b { grid-column: 7 / 13; margin-top: 0; }
    .collage-c { grid-column: 3 / 13; margin-top: 0; }
  }

  @media (max-width: 760px) {
    .collage { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .collage-a,
    .collage-crew,
    .collage-b,
    .collage-c { grid-column: 1 / -1; }
  }

  /* ---------- Section 08: the short index ---------- */

  .more-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .more-row {
    display: grid;
    grid-template-columns: 9.5rem 3rem minmax(0, 1.1fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .more-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: #0b1620;
  }

  .more-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .more-row:hover .more-thumb img {
    transform: scale(1.06);
  }

  /* viewfinder corner ticks: "this is a picture" */
  .more-corner {
    position: absolute;
    width: 0.6rem;
    height: 0.6rem;
    border: 0 solid rgb(255 255 255 / 0.85);
  }

  .more-corner--tl { top: 0.35rem; left: 0.35rem; border-top-width: 1px; border-left-width: 1px; }
  .more-corner--br { right: 0.35rem; bottom: 0.35rem; border-right-width: 1px; border-bottom-width: 1px; }

  .more-num {
    color: var(--color-accent);
  }

  .more-title {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    word-spacing: 0.1em;
    font-weight: 800;
    font-size: var(--display-4);
    line-height: 0.95;
    text-transform: uppercase;
    transition: color var(--duration) var(--ease);
  }

  .more-text {
    color: var(--color-muted);
  }

  .more-arrow {
    color: var(--color-accent);
    font-size: 1.25rem;
    transition: transform var(--duration) var(--ease);
  }

  .more-row:hover .more-title {
    color: var(--color-accent);
  }

  .more-row:hover .more-arrow {
    transform: translateX(6px);
  }

  @media (max-width: 760px) {
    .more-row {
      grid-template-columns: 6.5rem minmax(0, 1fr) auto;
      gap: 0.2rem var(--space-sm);
    }

    .more-thumb { grid-row: 1 / span 3; }
    .more-num { grid-column: 2; grid-row: 1; }
    .more-title { grid-column: 2; grid-row: 2; font-size: var(--display-5); }
    .more-text { grid-column: 2; grid-row: 3; font-size: var(--text-sm); }
    .more-arrow { grid-column: 3; grid-row: 1 / span 3; }
  }

  /* Section 03: the cards sit in front of the radiolarian (Specimen.astro) */
  /* Section 03 above is light too, so its bottom padding already gives the usual gap; the
     radiolarian sits across the join between the two, over the section's hairline, clear of the cards */
  .band--specimen > :global(.specimen) {
    z-index: 2;
  }

  .band--specimen > .section {
    position: relative;
    z-index: 1;
    padding-top: 0;
  }

  /* phones: the radiolarian sits on its own above the heading, smaller, instead of behind it */
  @media (max-width: 760px) {
    .band--specimen {
      padding-top: calc(40vw + 1rem);
    }

    .band--specimen :global(.specimen) {
      top: 1.25rem;
      width: 40vw;
    }

    .band--specimen :global(.specimen--right) {
      right: -8vw;
    }

    /* its caption stays on phones, small, to the left of it, so it reads as a specimen */
    .band.band--specimen :global(.specimen--right .specimen-label) {
      display: block;
      top: 42%;
      right: calc(100% + 0.25rem);
      width: 9.5rem;
      font-size: 0.6rem;
      white-space: normal;
      text-align: right;
      text-wrap: balance;
    }

    .band--specimen :global(.specimen-label::before) {
      display: none;
    }

    /* every featured photo still to come: on phones each card becomes a compact row, a small
       "photo to come" square beside its text, instead of three big empty panels in a row */
    .card-grid--pending > :global(.card) {
      display: grid;
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: var(--space-md);
      align-items: start;
    }

    .card-grid--pending :global(.card-media) {
      aspect-ratio: 1 / 1 !important;
    }

    .card-grid--pending :global(.card-body) {
      margin-top: 0; /* its rule lines up with the top of the square */
    }

    .card-grid--pending :global(.ph) {
      padding: 0.5rem;
    }

    /* in the small square only what the photo should show, like the News thumbnails */
    .card-grid--pending :global(.ph-corner),
    .card-grid--pending :global(.ph-tag),
