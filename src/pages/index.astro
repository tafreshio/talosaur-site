---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import { heroCards, featuredHeading, featuredCards, helpButtons, interestedCards } from '../data/home';
import { getSortedNews, formatNewsDate } from '../lib/news';
import { url } from '../lib/url';

// The four newest news entries (newest first)
const latestNews = (await getSortedNews()).slice(0, 4);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout headerOverlay>
  <HeroVideo />

  <!-- Section 01: headline and intro -->
  <section id="intro" class="container section intro">
    <SectionHeader number={1} />
    <div class="intro-grid">
      <h1 class="intro-title" data-reveal>Life at <span class="nowrap">50–300&nbsp;m</span> is barely watched.</h1>
      <div class="intro-body" data-reveal>
        <p class="intro-text">
          The ocean's twilight zone is too deep for divers and too costly to visit often.
          Talosaur is a Texas-based student team building a low-cost underwater robot that
          finds, follows and films marine life there.
        </p>
        <a class="button" href={url('/the-problem')}>Read more <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Section 02: three cards -->
  <section class="container section">
    <SectionHeader number={2} />
    <!-- Feature layout: the first card (Turtle) is big and square, the other two stack beside it -->
    <div class="card-grid card-grid--feature" data-reveal-group>
      {heroCards.map((card, i) => (
        <Card {...card} index={i + 1} ratio={i === 0 ? '1 / 1' : '16 / 9'} feature={i === 0} />
      ))}
    </div>
  </section>

  <!-- Section 03: featured content -->
  <section class="container section">
    <SectionHeader number={3} title={featuredHeading} />
    <!-- Stepped layout: each card sits a little lower than the one before -->
    <div class="card-grid card-grid--stepped" data-reveal-group>
      {featuredCards.map((card, i) => <Card {...card} index={i + 1} ratio="16 / 9" />)}
    </div>
  </section>

  <!-- Section 04: How can we help? -->
  <section class="container section">
    <SectionHeader number={4} title="How can we help?" />
    <ol class="help-list" data-reveal-group>
      {helpButtons.map((button, i) => (
        <li>
          <a class="help-row" href={url(button.href)}>
            <span class="label help-num">{pad(i + 1)}</span>
            <span class="help-label">{button.label}</span>
            <span class="help-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Section 05: latest news -->
  <section class="container section">
    <SectionHeader number={5} title="Latest news">
      <a class="text-link" href={url('/news')}>All news <span aria-hidden="true">→</span></a>
    </SectionHeader>
    <ol class="news-grid" data-reveal-group>
      {latestNews.map((entry) => (
        <li class="news-card">
          <p class="label news-meta">
            {entry.data.date
              ? <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatNewsDate(entry)}</time>
              : <span>{formatNewsDate(entry)}</span>}
            <span class="news-kind">News</span>
          </p>
          <h3 class="news-title">
            <a href={url(`/news#${entry.id}`)}>{entry.data.title}</a>
          </h3>
        </li>
      ))}
    </ol>
  </section>

  <!-- Section 06: You may also be interested in -->
  <section class="container section">
    <SectionHeader number={6} title="You may also be interested in" />
    <div class="card-grid" data-reveal-group>
      {interestedCards.map((card, i) => <Card {...card} index={i + 1} ratio="16 / 9" />)}
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: var(--space-2xl);
  }

  /* ---------- Section 01 ---------- */

  .intro {
    scroll-margin-top: var(--header-height); /* so the "Scroll" link doesn't hide it under the header */
  }

  /* Headline on the left, text and button on the right, both starting at the top */
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-lg) var(--space-xl);
    align-items: start;
  }

  .intro-title {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1rem + 6.5vw, 7rem);
  }

  .nowrap {
    white-space: nowrap; /* keeps "50–300 m" on one line */
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: 34rem;
    padding-top: 0.6rem; /* lines the first line of text up with the top of the headline */
  }

  .intro-text {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  /* ---------- Card grids (sections 02, 03, 06) ---------- */

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-md);
  }

  /* Section 02: a wide left column for the big card, a narrower right column for the
     other two. "grid-row: span 2" lets the big card take the height of both rows.
     :global() is needed because the cards come from Card.astro, and Astro's scoped
     styles here would otherwise only match elements written in this file. */
  .card-grid--feature {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: var(--space-lg) var(--space-lg);
  }

  .card-grid--feature > :global(:first-child) {
    grid-row: span 2;
  }

  /* Section 03: the 2nd and 3rd cards are pushed down a step each, so the row
     reads as a staircase instead of a flat line */
  .card-grid--stepped > :global(:nth-child(2)) {
    margin-top: var(--space-xl);
  }

  .card-grid--stepped > :global(:nth-child(3)) {
    margin-top: calc(var(--space-xl) * 2);
  }

  /* ---------- Section 04: three big rows ---------- */

  .help-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-line);
  }

  .help-row {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-line);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .help-num {
    color: var(--color-accent);
  }

  .help-label {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: var(--text-2xl);
    line-height: 1;
    text-transform: uppercase;
    transition: transform var(--duration) var(--ease);
  }

  .help-arrow {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-accent);
    transition: transform var(--duration) var(--ease);
  }

  .help-row:hover {
    color: var(--color-accent);
  }

  .help-row:hover .help-label {
    transform: translateX(0.25em);
  }

  .help-row:hover .help-arrow {
    transform: translateX(8px);
  }

  /* ---------- Section 05: latest news ---------- */

  .news-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
    transition: border-color var(--duration) var(--ease);
  }

  .news-card:hover {
    border-top-color: var(--color-accent);
  }

  .news-card:hover .news-title {
    color: var(--color-accent);
  }

  /* Date on the left, "News" on the right */
  .news-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    margin: 0;
    color: var(--color-accent);
  }

  .news-kind {
    color: var(--color-muted);
  }

  .news-title {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.3;
    text-transform: none;
    letter-spacing: 0;
    transition: color var(--duration) var(--ease);
  }

  .news-title a {
    text-decoration: none;
  }

  /* Whole card is clickable */
  .news-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* ---------- Tablet ---------- */

  @media (max-width: 1023px) {
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Phone ---------- */

  @media (max-width: 760px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    .intro-body {
      padding-top: 0;
    }

    .intro-text {
      font-size: var(--text-base);
    }

    .card-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    /* One column on phones: no spanning, no steps */
    .card-grid--feature > :global(:first-child) {
      grid-row: auto;
    }

    .card-grid--stepped > :global(:nth-child(2)),
    .card-grid--stepped > :global(:nth-child(3)) {
      margin-top: 0;
    }

    .help-row {
      grid-template-columns: 2.5rem 1fr auto;
      gap: var(--space-sm);
    }

    .help-label {
      font-size: var(--text-xl);
    }
  }

  @media (max-width: 480px) {
    .news-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
