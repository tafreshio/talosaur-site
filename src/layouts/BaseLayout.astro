---
// The shell every page sits inside: <head>, header, page content, footer.
// A page uses it like this:
//   <BaseLayout title="News"> ...page content... </BaseLayout>
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // true = the header floats transparently over the top of the page (used with a full-screen hero)
  headerOverlay?: boolean;
}

const {
  title,
  headerOverlay = false,
  description = 'Talosaur is a Texas-based student team building a low-cost underwater robot that finds, follows and films marine life in the ocean\'s twilight zone.',
} = Astro.props;

const fullTitle = title ? `${title} | Talosaur` : 'Talosaur';

// Full addresses for the social-share preview (uses "site" and "base" in astro.config.mjs).
// Astro.url.pathname already includes the base; the image path gets it from url().
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(url('/images/og-image.jpg'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06121f" />
    <title>{fullTitle}</title>

    <!-- Icons. PLACEHOLDER: swap favicon.svg, favicon.png and apple-touch-icon.png for the real logo -->
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="64x64" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <!-- How the page looks when shared on social media or in chat apps -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Talosaur" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Archivo (headlines), Inter (body), IBM Plex Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
    />

    <!-- Marks that JavaScript is running, so the scroll-in animations only hide things when they can reveal them -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={headerOverlay} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-in animation: anything with a data-reveal attribute fades up when it comes into view.
      // Elements inside a data-reveal-group fade in one after another.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group]');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => observer.observe(el));

        // Safety net: if anything is still hidden after a few seconds, show it anyway.
        setTimeout(() => targets.forEach((el) => el.classList.add('is-visible')), 4000);
      }
    </script>
  </body>
</html>
